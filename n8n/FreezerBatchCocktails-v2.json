    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst recipe = data.recipe && typeof data.recipe === 'object' ? data.recipe : {};\nconst display = recipe.display && typeof recipe.display === 'object' ? recipe.display : {};\nconst plain = (value) => String(value ?? '').replace(/[\\r\\n]+/g, ' ').trim();\nconst bounded = (value, max = 160) => Array.from(plain(value)).slice(0, max).join('');\nconst escapeHtml = (value) => bounded(value).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\\"/g, '&quot;').replace(/'/g, '&#39;');\nconst show = (value, fallback = '—') => escapeHtml(bounded(value) || fallback);\nconst slugLabel = (slug) => bounded(slug, 80).split('-').filter(Boolean).map((part) => part[0]?.toUpperCase() + part.slice(1)).join(' ');\nconst unit = recipe.unit === 'oz' || recipe.unit === 'ml' ? recipe.unit : 'ml';\nconst bottleFallback = Number.isInteger(recipe.bottleMl) ? `${recipe.bottleMl} ml` : '—';\nconst dilutionFallback = recipe.mode === 'custom' && Number.isFinite(recipe.dilutionPercent) ? `${recipe.dilutionPercent}%` : '—';\nconst recipeNamePlain = bounded(display.name) || (recipe.mode === 'preset' ? slugLabel(recipe.slug) : '') || (recipe.mode === 'custom' ? 'Custom Freezer Batch' : 'Freezer Batch');\nconst recipeName = escapeHtml(recipeNamePlain);\nconst presentationIngredients = Array.isArray(display.ingredients) ? display.ingredients : [];\nconst coreIngredients = recipe.mode === 'custom' && Array.isArray(recipe.ingredients) ? recipe.ingredients : [];\nconst ingredients = presentationIngredients.length ? presentationIngredients : coreIngredients.map((ingredient) => ({ name: ingredient?.name, amount: `${ingredient?.amount ?? ''} ${unit}`.trim() }));\nconst ingredientRows = ingredients.length ? ingredients.map((ingredient) => `<tr><td>${show(ingredient?.name, 'Ingredient')}</td><td>${show(ingredient?.amount)}</td></tr>`).join('') : `<tr><td colspan='2'>See the calculator for the complete ingredient list.</td></tr>`;\nconst textIngredients = ingredients.length ? ingredients.map((ingredient) => `- ${bounded(ingredient?.name) || 'Ingredient'}: ${bounded(ingredient?.amount) || '—'}`).join('\\n') : '- See the calculator for the complete ingredient list.';\nconst abv = show(display.abv);\nconst servings = show(display.servings);\nconst bottleSize = show(display.bottleSize, bottleFallback);\nconst dilution = show(display.dilution, dilutionFallback);\nconst pourOff = show(display.pourOff, 'See calculator');\nconst waterToAdd = show(display.waterToAdd, 'See calculator');\nconst websiteUrl = 'https://freezerbatchcocktails.com';\nconst unsubscribeUrl = 'https://freezerbatchcocktails.com/unsubscribe';\nconst html = `<!doctype html><html><body style='margin:0;background:#171411;color:#f4ede3;font-family:Arial,sans-serif;'><table role='presentation' width='100%'><tr><td align='center' style='padding:32px 16px;'><table role='presentation' width='600' style='max-width:600px;background:#241f1a;border:1px solid #3b342e;'><tr><td style='padding:36px;background:#0e0c0a;border-bottom:4px solid #d7b46a;'><p style='margin:0;color:#d7b46a;letter-spacing:2px;font-size:12px;'>FREEZER BATCH COCKTAILS</p><h1 style='color:#f4ede3;'>${recipeName}</h1></td></tr><tr><td style='padding:32px;'><p style='color:#c8c0b7;'>A measured batch for your freezer door.</p><p><strong>ABV:</strong> ${abv} · <strong>Drinks:</strong> ${servings} · <strong>Bottle:</strong> ${bottleSize} · <strong>Dilution:</strong> ${dilution}</p><p><strong>First:</strong> pour off ${pourOff} to make room.</p><h2>Add these ingredients</h2><table role='presentation' width='100%'>${ingredientRows}<tr><td>Water (dilution)</td><td>${waterToAdd}</td></tr></table><p><strong>Freezer note:</strong> cocktails under 22% ABV may freeze too firm to pour. Fresh citrus evolves in the freezer; for longer storage, batch the spirits and add fresh citrus when serving.</p><p><a href='${escapeHtml(websiteUrl)}/cocktails'>Browse cocktails</a></p></td></tr><tr><td style='padding:22px;background:#0e0c0a;color:#a69d93;'>Freezer Batch Cocktails · <a href='${escapeHtml(unsubscribeUrl)}'>Unsubscribe from marketing</a></td></tr></table></td></tr></table></body></html>`;\nconst text = `FREEZER BATCH COCKTAILS\\n\\n${recipeNamePlain}\\nABV: ${bounded(display.abv) || '—'} · Drinks: ${bounded(display.servings) || '—'} · Bottle: ${bounded(display.bottleSize) || bottleFallback}\\nDilution: ${bounded(display.dilution) || dilutionFallback}\\n\\nFirst, pour off ${bounded(display.pourOff) || 'See calculator'} to make room.\\n\\nIngredients:\\n${textIngredients}\\n- Water (dilution): ${bounded(display.waterToAdd) || 'See calculator'}\\n\\nFreezer note: cocktails under 22% ABV may freeze too firm to pour. Fresh citrus evolves in the freezer; for longer storage, batch the spirits and add fresh citrus when serving.\\n\\nBrowse cocktails: ${websiteUrl}/cocktails`;\nreturn [{ json: { ...data, html, text, subject: `Your ${recipeNamePlain} recipe` } }];"
      },
