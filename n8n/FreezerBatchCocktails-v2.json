        "jsCode": "const headers = $json.headers || {};\nconst providedSecret = headers['x-fbc-webhook-secret'] || headers['X-FBC-Webhook-Secret'];\nconst expectedSecret = $env.N8N_WEBHOOK_SECRET; // NOTE: the live node hardcodes this literal (no Variables feature on this plan). Never commit the literal — see n8n/SECURITY.md.\n\n// Keep failed authentication isolated from the request body so it cannot have side effects.\nif (typeof providedSecret !== 'string' || typeof expectedSecret !== 'string' || providedSecret !== expectedSecret) {\n  return [{ json: { authorized: false } }];\n}\n\nconst body = $json.body && typeof $json.body === 'object' ? $json.body : {};\nreturn [{\n  json: {\n    authorized: true,\n    action: body.action,\n    requestId: headers['x-fbc-request-id'] || headers['X-FBC-Request-Id'] || body.requestId,\n    email: body.email,\n    page: body.page,\n    marketingConsent: body.marketingConsent === true,\n    consentVersion: body.consentVersion || '',\n    recipe: body.recipe || null,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
