    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Cold Open welcome email. Source of truth: n8n/emails/cold-open/welcome.html in the\n// site repo, with the image row and the preferences link removed (no Negroni\n// photography and no preferences page exist yet). Keep this in sync with that file.\nconst TEMPLATE = \"<!DOCTYPE html>\\r\\n<html lang=\\\"en\\\" xmlns:v=\\\"urn:schemas-microsoft-com:vml\\\">\\r\\n<head>\\r\\n<meta charset=\\\"utf-8\\\">\\r\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\r\\n<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\">\\r\\n<meta name=\\\"supported-color-schemes\\\" content=\\\"light dark\\\">\\r\\n<title>Cold Open by FBC — Welcome</title>\\r\\n<!--[if !mso]><!--><link href=\\\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Outfit:wght@300;400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\"><!--<![endif]-->\\r\\n<!--[if mso]><style>table{border-collapse:collapse;}</style><![endif]-->\\r\\n</head>\\r\\n<body style=\\\"margin:0; padding:0; background-color:#0c0a08;\\\">\\r\\n<span style=\\\"display:none; font-size:1px; color:#0c0a08; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;\\\">Your printable bottle-label sheet is inside — plus what arrives, and how often.</span>\\r\\n<table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" width=\\\"100%\\\" style=\\\"background-color:#0c0a08;\\\">\\r\\n<tr><td align=\\\"center\\\" style=\\\"padding:24px 12px;\\\">\\r\\n<table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" width=\\\"600\\\" style=\\\"width:600px; max-width:600px;\\\">\\r\\n\\r\\n<!-- masthead -->\\r\\n<tr><td align=\\\"center\\\" style=\\\"padding:34px 24px 8px; background-color:#0c0a08;\\\">\\r\\n  <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\"><tr>\\r\\n    <td width=\\\"44\\\" style=\\\"width:44px; border-top:1px solid #c8a55c; font-size:1px; line-height:1px;\\\">&nbsp;</td>\\r\\n  </tr></table>\\r\\n</td></tr>\\r\\n<tr><td align=\\\"center\\\" bgcolor=\\\"#0c0a08\\\" style=\\\"background-color:#0c0a08; padding:12px 24px 4px; font-family:'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-size:30px; letter-spacing:6px; color:#f0e8da; text-transform:uppercase; mso-line-height-rule:exactly; line-height:36px;\\\">Cold Open</td></tr>\\r\\n<tr><td align=\\\"center\\\" bgcolor=\\\"#0c0a08\\\" style=\\\"background-color:#0c0a08; padding:0 24px 6px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:11px; letter-spacing:4px; color:#c8a55c; text-transform:uppercase;\\\">By FBC</td></tr>\\r\\n<tr><td align=\\\"center\\\" bgcolor=\\\"#0c0a08\\\" style=\\\"background-color:#0c0a08; padding:0 24px 26px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:11px; letter-spacing:2px; color:#9a8e7e; text-transform:uppercase;\\\">Ready before the guests arrive</td></tr>\\r\\n\\r\\n<!-- welcome card -->\\r\\n<tr><td style=\\\"background-color:#161310; padding:36px 40px 8px;\\\">\\r\\n  <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" width=\\\"520\\\" style=\\\"width:520px;\\\">\\r\\n    <tr><td style=\\\"font-family:'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-size:26px; color:#f0e8da; mso-line-height-rule:exactly; line-height:34px;\\\">You're in. Here's your label sheet.</td></tr>\\r\\n    <tr><td style=\\\"padding:14px 0 0; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:15px; color:#e8e0d4; mso-line-height-rule:exactly; line-height:24px;\\\">Print it, batch something, and write on it with whatever pen is closest. Six labels per page, sized for 750&nbsp;ml swing-tops, and they survive the freezer better than your memory of what's in the bottle.</td></tr>\\r\\n    <tr><td style=\\\"padding:26px 0 10px;\\\">\\r\\n      <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\"><tr>\\r\\n        <td bgcolor=\\\"#c8a55c\\\" style=\\\"background-color:#c8a55c;\\\">\\r\\n          <a href=\\\"{{LABEL_SHEET_URL}}\\\" style=\\\"display:block; padding:15px 34px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:13px; font-weight:bold; letter-spacing:2px; text-transform:uppercase; color:#161310; text-decoration:none; mso-line-height-rule:exactly; line-height:16px;\\\">Download your label sheet</a>\\r\\n        </td>\\r\\n      </tr></table>\\r\\n    </td></tr>\\r\\n  </table>\\r\\n</td></tr>\\r\\n\\r\\n<!-- expectations -->\\r\\n<tr><td style=\\\"background-color:#161310; padding:24px 40px 8px;\\\">\\r\\n  <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" width=\\\"520\\\" style=\\\"width:520px;\\\">\\r\\n    <tr><td style=\\\"border-top:1px solid #2e2720; padding:22px 0 12px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:11px; letter-spacing:3px; color:#c8a55c; text-transform:uppercase;\\\">What arrives, and how often</td></tr>\\r\\n    <tr><td style=\\\"padding:4px 0; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:14px; color:#e8e0d4; mso-line-height-rule:exactly; line-height:23px;\\\"><span style=\\\"color:#f0e8da;\\\">Monthly:</span> one make-ahead recipe and a hosting timeline that works backward from the doorbell.</td></tr>\\r\\n    <tr><td style=\\\"padding:4px 0; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:14px; color:#e8e0d4; mso-line-height-rule:exactly; line-height:23px;\\\"><span style=\\\"color:#f0e8da;\\\">Occasionally:</span> a short countdown series before the big hosting holidays. Skippable, and clearly labeled.</td></tr>\\r\\n    <tr><td style=\\\"padding:4px 0 20px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:14px; color:#e8e0d4; mso-line-height-rule:exactly; line-height:23px;\\\"><span style=\\\"color:#f0e8da;\\\">Never:</span> daily email, countdown clocks, or anything shouting LAST CHANCE.</td></tr>\\r\\n  </table>\\r\\n</td></tr>\\r\\n\\r\\n<!-- featured recipe -->\\r\\n<tr><td style=\\\"background-color:#161310; padding:8px 40px 40px;\\\">\\r\\n  <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" width=\\\"520\\\" style=\\\"width:520px;\\\">\\r\\n    <tr><td style=\\\"border-top:1px solid #2e2720; padding:22px 0 14px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:11px; letter-spacing:3px; color:#c8a55c; text-transform:uppercase;\\\">Start here</td></tr>\\r\\n    <tr><td>\\r\\n      <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" width=\\\"520\\\" style=\\\"width:520px; border:1px solid #2e2720;\\\">\\r\\n        <tr><td style=\\\"padding:20px 24px 6px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:11px; letter-spacing:3px; color:#9a8e7e; text-transform:uppercase;\\\">Gin · Stirred · Freezer safe</td></tr>\\r\\n        <tr><td style=\\\"padding:0 24px; font-family:'Cormorant Garamond', Georgia, 'Times New Roman', serif; font-size:22px; color:#f0e8da; mso-line-height-rule:exactly; line-height:30px;\\\">The Negroni</td></tr>\\r\\n        <tr><td style=\\\"padding:8px 24px 18px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:14px; color:#e8e0d4; mso-line-height-rule:exactly; line-height:22px;\\\">Equal parts, foolproof, and it improves in the freezer. The calculator scales it to your bottle.</td></tr>\\r\\n        <tr><td style=\\\"padding:0 24px 24px;\\\">\\r\\n          <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\"><tr>\\r\\n            <td style=\\\"border:1px solid #c8a55c;\\\">\\r\\n              <a href=\\\"{{RECIPE_URL}}\\\" style=\\\"display:block; padding:11px 24px; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:12px; font-weight:bold; letter-spacing:2px; text-transform:uppercase; color:#c8a55c; text-decoration:none; mso-line-height-rule:exactly; line-height:14px;\\\">Batch the Negroni</a>\\r\\n            </td>\\r\\n          </tr></table>\\r\\n        </td></tr>\\r\\n      </table>\\r\\n    </td></tr>\\r\\n  </table>\\r\\n</td></tr>\\r\\n\\r\\n<!-- footer -->\\r\\n<tr><td align=\\\"center\\\" style=\\\"padding:28px 40px 40px; background-color:#0c0a08;\\\">\\r\\n  <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" width=\\\"520\\\" style=\\\"width:520px;\\\">\\r\\n    <tr><td align=\\\"center\\\" style=\\\"padding:0 0 14px;\\\"><table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\"><tr><td width=\\\"44\\\" style=\\\"width:44px; border-top:1px solid #3d3428; font-size:1px; line-height:1px;\\\">&nbsp;</td></tr></table></td></tr>\\r\\n    <tr><td align=\\\"center\\\" style=\\\"font-family:Outfit, Helvetica, Arial, sans-serif; font-size:12px; color:#9a8e7e; mso-line-height-rule:exactly; line-height:20px;\\\">You're getting this because you joined Cold Open by FBC at <a href=\\\"https://freezerbatchcocktails.com\\\" style=\\\"color:#c8a55c; text-decoration:none;\\\">freezerbatchcocktails.com</a>.</td></tr>\\r\\n    <tr><td align=\\\"center\\\" style=\\\"padding:10px 0 0; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:12px; color:#9a8e7e; mso-line-height-rule:exactly; line-height:20px;\\\"><a href=\\\"{{UNSUBSCRIBE_URL}}\\\" style=\\\"color:#c8a55c; text-decoration:underline;\\\">Unsubscribe</a></td></tr>\\r\\n    <tr><td align=\\\"center\\\" style=\\\"padding:10px 0 0; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:11px; color:#9a8e7e; mso-line-height-rule:exactly; line-height:18px;\\\">{{COMPANY_NAME}}</td></tr>\\r\\n    <tr><td align=\\\"center\\\" style=\\\"padding:10px 0 0; font-family:Outfit, Helvetica, Arial, sans-serif; font-size:11px; color:#9a8e7e; mso-line-height-rule:exactly; line-height:18px;\\\">For readers 21+. Please drink responsibly.</td></tr>\\r\\n  </table>\\r\\n</td></tr>\\r\\n\\r\\n</table>\\r\\n</td></tr>\\r\\n</table>\\r\\n</body>\\r\\n</html>\\r\\n\";\n\nconst TOKENS = {\n  \"{{LABEL_SHEET_URL}}\": \"https://freezerbatchcocktails.com/downloads/fbc-bottle-labels.pdf\",\n  \"{{RECIPE_URL}}\": \"https://freezerbatchcocktails.com/cocktails/negroni\",\n  \"{{UNSUBSCRIBE_URL}}\": \"https://freezerbatchcocktails.com/unsubscribe\",\n  \"{{COMPANY_NAME}}\": \"Freezer Batch Cocktails\"\n};\n\nlet html = TEMPLATE;\nfor (const [token, value] of Object.entries(TOKENS)) {\n  html = html.split(token).join(value);\n}\n\n// The template must reach Resend with no merge tokens left.\nconst leftover = html.match(/\\{\\{[^}]*\\}\\}/g);\nif (leftover) {\n  throw new Error('Unresolved merge tokens in welcome email: ' + [...new Set(leftover)].join(', '));\n}\nif (!html.includes(TOKENS['{{UNSUBSCRIBE_URL}}'])) {\n  throw new Error('Welcome email is missing its unsubscribe link');\n}\n\nconst text = \"COLD OPEN BY FBC\\n\\nYou're in. Here's your label sheet.\\n\\nDownload your label sheet: https://freezerbatchcocktails.com/downloads/fbc-bottle-labels.pdf\\n\\nWhat arrives, and how often\\n  Monthly - one make-ahead recipe and a hosting timeline.\\n  Occasionally - a technique note when it earns the send.\\n  Never - urgency, countdowns, or a nagging cart.\\n\\nStart here: batch the Negroni - https://freezerbatchcocktails.com/cocktails/negroni\\n\\n---\\nUnsubscribe: https://freezerbatchcocktails.com/unsubscribe\\nFreezer Batch Cocktails\\nPlease drink responsibly. You must be 21+ to purchase alcohol in the US.\";\n\nreturn [{ json: { ...data, html, text, subject: \"You're in — your label sheet is inside\" } }];\n"
      },
