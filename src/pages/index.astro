---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import CocktailCard from '../components/CocktailCard.astro';
import EmailSignup from '../components/EmailSignup.astro';
import cocktailsData from '../data/cocktails.json';
import { calculateMilkStreetBatch, MILK_STREET_BATCHES } from '../lib/calculator';

const title = 'Freezer Batch Cocktails';
const description = 'Calculate exact measurements for freezer batch cocktails. Do the math once, drink well forever. Free batch calculator for pre-mixed cocktails.';

// Derive ABV/freeze-status/servings from the same calculator users interact with.
const enriched = cocktailsData.cocktails.map(c => {
  const batch = MILK_STREET_BATCHES[c.slug] ? calculateMilkStreetBatch(c.slug, 750) : null;
  return {
    ...c,
    finalAbv: batch ? Math.round(batch.finalAbv) : c.finalAbv,
    servings: batch ? batch.servings : c.servings,
    freezeStatus: batch ? batch.freezeStatus : c.freezeStatus,
  };
});

const featuredCocktails = enriched
  .filter(c => c.reliability === 'bulletproof')
  .slice(0, 6);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Freezer Batch Cocktails Calculator",
  "description": description,
  "url": "https://freezerbatchcocktails.com",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout title={title} description={description} schema={schema}>

  <!-- ============================================================
       HERO — cinematic typographic, with decanter photo backdrop
       ============================================================ -->
  <section class="relative overflow-hidden">
    <!-- Backdrop photo with Ken Burns slow zoom -->
    <div class="absolute inset-0 overflow-hidden">
      <picture>
        <source media="(max-width: 639px)" srcset="/images/hero-decanters-mobile.webp" type="image/webp" />
        <source media="(min-width: 640px)" srcset="/images/hero-decanters.webp" type="image/webp" />
        <img
          src="/images/hero-decanters.jpg"
          alt=""
          class="w-full h-full object-cover object-center opacity-70 ken-burns"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <!-- Soft vignette: keeps the headline readable without crushing the photo -->
      <div class="absolute inset-0 pointer-events-none" style="background:
        radial-gradient(ellipse at center, rgba(12,10,8,0.15) 0%, rgba(12,10,8,0.55) 70%, rgba(12,10,8,0.85) 100%);
      "></div>
      <!-- Bottom-fade gradient: blends into the page below -->
      <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg, rgba(12,10,8,0.05) 0%, rgba(12,10,8,0.25) 50%, #0c0a08 100%);"></div>
    </div>

    <div class="relative z-10 max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-20 pt-28 pb-32 sm:pt-32 sm:pb-40 text-center">
      <p class="reveal reveal-1 section-eyebrow">The Freezer Batch Calculator</p>

      <h1 class="reveal reveal-2 font-display italic font-normal text-cream-100 leading-[1.05] mb-8" style="font-size: clamp(2.75rem, 7vw, 5.125rem);">
        Do the math once,<br/>drink well forever
      </h1>

      <p class="reveal reveal-3 max-w-xl mx-auto text-[17px] sm:text-[18px] leading-[1.7] text-study-muted font-light mb-12">
        Pre-batch cocktails that stay perfectly pourable in your freezer.
        Enter a recipe — we calculate the rest.
      </p>

      <div class="reveal reveal-scale reveal-4 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#calculator" class="btn-primary">Start batching</a>
        <a href="/cocktails" class="btn-secondary">Browse {enriched.length} recipes</a>
      </div>

      <!-- Decorative gradient line -->
      <div class="study-line mt-24"></div>
    </div>
  </section>

  <!-- ============================================================
       HOW IT WORKS — three steps, top brass border
       ============================================================ -->
  <section class="relative z-10 py-24 sm:py-32">
    <div class="max-w-[1100px] mx-auto px-6 sm:px-10 lg:px-20">

      <div class="text-center mb-20 scroll-reveal">
        <p class="section-eyebrow">Method</p>
        <h2 class="section-title italic">Three steps to perfection</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-12 lg:gap-16 scroll-reveal-stagger">
        {[
          { num: '01', title: 'Pour Off', desc: 'Remove the calculated amount of spirit from your bottle to make room for the other ingredients.' },
          { num: '02', title: 'Add & Shake', desc: 'Add your ingredients and dilution water directly into the bottle. Seal and shake well.' },
          { num: '03', title: 'Freeze & Pour', desc: 'Store for 4+ hours. Pour straight into a glass. Perfectly chilled, zero effort.' },
        ].map(step => (
          <div class="border-t border-study-border-light pt-8">
            <div class="font-display italic text-[48px] text-accent-500 font-light leading-none mb-4">{step.num}</div>
            <h3 class="font-display text-[22px] text-cream-100 font-medium mb-3">{step.title}</h3>
            <p class="text-[15px] text-study-muted leading-[1.7] font-light">{step.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-20">
        <a href="/how-it-works" class="btn-ghost">Learn the science →</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CALCULATOR — on bgCard, full functionality preserved
       ============================================================ -->
  <section id="calculator" class="relative z-10 bg-study-card py-24 sm:py-32 scroll-mt-24">
    <div class="max-w-[1100px] mx-auto px-6 sm:px-10 lg:px-20">

      <div class="text-center mb-16 scroll-reveal">
        <p class="section-eyebrow">Calculator</p>
        <h2 class="section-title italic">Build your batch</h2>
        <p class="section-subtitle max-w-xl mx-auto">
          Pick a classic recipe — we calculate pour amounts, ABV, and freeze status.
        </p>
      </div>

      <div class="scroll-reveal">
        <Calculator />
      </div>
    </div>
  </section>

  <!-- ============================================================
       FEATURED COCKTAILS — dark grid
       ============================================================ -->
  <section class="relative z-10 py-24 sm:py-32">
    <div class="max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-20">

      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6 mb-16 scroll-reveal">
        <div>
          <p class="section-eyebrow">Collection</p>
          <h2 class="section-title italic">Classic freezer batches</h2>
        </div>
        <a href="/cocktails" class="btn-ghost shrink-0">View all {enriched.length} recipes →</a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 scroll-reveal-stagger">
        {featuredCocktails.map(cocktail => (
          <CocktailCard
            slug={cocktail.slug}
            name={cocktail.name}
            tagline={cocktail.tagline}
            baseSpirit={cocktail.baseSpirit}
            reliability={cocktail.reliability as 'bulletproof' | 'needs-attention'}
            finalAbv={cocktail.finalAbv}
            freezeStatus={cocktail.freezeStatus as 'freeze' | 'slushy' | 'safe'}
            servings={cocktail.servings}
            technique={cocktail.recipe?.dilutionType}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SCIENCE SECTION — bgCard with stat callouts
       ============================================================ -->
  <section class="relative z-10 bg-study-card py-24 sm:py-32">
    <div class="max-w-[820px] mx-auto px-6 sm:px-10 lg:px-20 text-center">
      <p class="section-eyebrow">The Science</p>
      <h2 class="section-title italic mb-8">Why it works</h2>

      <p class="text-[17px] leading-[1.8] text-study-muted font-light mb-16 max-w-xl mx-auto">
        Alcohol freezes at −114°C. By keeping your cocktail above 22% ABV, it stays perfectly pourable at standard freezer temperatures. We calculate the exact dilution water to replicate what ice would normally contribute, giving you a perfectly balanced, ice-cold cocktail ready to pour.
      </p>

      <div class="grid grid-cols-3 gap-8 sm:gap-12">
        {[
          { val: '−18°C', label: 'Your freezer' },
          { val: '22%+', label: 'Minimum ABV' },
          { val: '4 hrs', label: 'Minimum chill' },
        ].map(s => (
          <div>
            <div class="font-display italic text-[32px] sm:text-[40px] text-accent-500 font-light mb-3 leading-none">{s.val}</div>
            <div class="text-[11px] tracking-[0.2em] uppercase text-study-muted font-medium">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="mt-12">
        <a href="/how-it-works" class="btn-ghost">Deep dive into the science →</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       NEWSLETTER
       ============================================================ -->
  <section class="relative z-10 py-16">
    <div class="max-w-[820px] mx-auto px-6 sm:px-10">
      <EmailSignup
        headline="Join the batch"
        subheadline="New recipes, freezer hacks, and the occasional spirit recommendation."
        buttonText="Subscribe"
      />
    </div>
  </section>

  <!-- ============================================================
       BAR TOOLS (affiliate) — minimal, two-column
       ============================================================ -->
  <section class="relative z-10 bg-study-card py-24 border-t border-study-border">
    <div class="max-w-[1100px] mx-auto px-6 sm:px-10 lg:px-20">
      <div class="text-center mb-12">
        <p class="section-eyebrow">The Tools</p>
        <h2 class="section-title italic">Stock your bar</h2>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { name: 'Japanese Jigger', desc: 'Precise measurements', url: 'https://www.amazon.com/s?k=cocktail+jigger+japanese&tag=probuild20-20' },
          { name: 'Mini Funnel', desc: 'No-spill bottle filling', url: 'https://www.amazon.com/s?k=stainless+steel+funnel+small&tag=probuild20-20' },
          { name: 'Swing-Top Bottles', desc: 'Batch storage', url: 'https://www.amazon.com/s?k=swing+top+glass+bottles+750ml&tag=probuild20-20' },
          { name: 'Pour Spouts', desc: 'Controlled pours', url: 'https://www.amazon.com/s?k=liquor+pour+spouts+stainless&tag=probuild20-20' },
        ].map(item => (
          <a href={item.url} target="_blank" rel="noopener noreferrer"
             class="group block bg-study-bg border border-study-border p-6 hover:border-accent-500 transition-all">
            <h3 class="font-display italic text-[20px] text-cream-100 font-normal mb-2">{item.name}</h3>
            <p class="text-[13px] text-study-muted leading-[1.6] font-light mb-4">{item.desc}</p>
            <span class="text-[10px] uppercase tracking-[0.2em] text-accent-500 group-hover:text-accent-300 transition-colors">Shop →</span>
          </a>
        ))}
      </div>

      <p class="text-center text-[11px] text-study-muted/70 mt-10 uppercase tracking-[0.2em]">
        As an Amazon Associate, we earn from qualifying purchases.
      </p>
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA
       ============================================================ -->
  <section class="relative z-10 py-24 sm:py-32 text-center">
    <div class="max-w-[700px] mx-auto px-6 sm:px-10">
      <h2 class="section-title italic mb-4">Ready to make your first batch?</h2>
      <p class="text-[16px] text-study-muted leading-[1.7] font-light mb-10">
        The Negroni is the perfect place to start. Equal parts, foolproof, and it actually improves with freezer time.
      </p>
      <a href="/cocktails/negroni" class="btn-primary">Start with the Negroni</a>
    </div>
  </section>

</Layout>
