---
import Layout from '../../layouts/Layout.astro';
import Calculator from '../../components/Calculator.astro';
import CocktailCard from '../../components/CocktailCard.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import GlassIcon from '../../components/GlassIcon.astro';
import type { GlassType } from '../../components/GlassIcon.astro';
import cocktailsData from '../../data/cocktails.json';
import { calculateMilkStreetBatch, MILK_STREET_BATCHES } from '../../lib/calculator';

// Map each cocktail to the glass it's traditionally served in. Used to
// give each recipe page a small piece of visual identity without photos.
const GLASS_BY_SLUG: Record<string, GlassType> = {
  negroni: 'rocks',
  manhattan: 'coupe',
  'old-fashioned': 'rocks',
  boulevardier: 'rocks',
  'dirty-martini': 'coupe',
  margarita: 'coupe',
  cosmopolitan: 'coupe',
  'moscow-mule': 'mug',
  'espresso-martini': 'coupe',
  'paper-plane': 'coupe',
  daiquiri: 'coupe',
  vesper: 'coupe',
  'mint-julep': 'julep',
  'vieux-carre': 'rocks',
  'hanky-panky': 'coupe',
  aviation: 'coupe',
  sazerac: 'rocks',
  bijou: 'coupe',
};

export function getStaticPaths() {
  return cocktailsData.cocktails.map(cocktail => ({
    params: { slug: cocktail.slug },
    props: { cocktail }
  }));
}

const { cocktail } = Astro.props;

// Single source of truth for ABV / servings: derive from the same
// calculator the user interacts with below. Falls back to the JSON
// value for cocktails that don't have a Milk Street batch defined.
const liveBatch = MILK_STREET_BATCHES[cocktail.slug]
  ? calculateMilkStreetBatch(cocktail.slug, 750)
  : null;
const displayAbv = liveBatch ? Math.round(liveBatch.finalAbv) : cocktail.finalAbv;
const displayServings = liveBatch ? liveBatch.servings : cocktail.servings;
const displayFreezeStatus = liveBatch ? liveBatch.freezeStatus : cocktail.freezeStatus;
const glassType: GlassType = GLASS_BY_SLUG[cocktail.slug] ?? 'coupe';

// Get related cocktails
const relatedCocktails = cocktailsData.cocktails
  .filter(c => cocktail.relatedCocktails?.includes(c.slug))
  .slice(0, 3);

const statusLabels = {
  safe: { text: 'Freezer Safe', icon: '✓', class: 'status-safe' },
  slushy: { text: 'Slushy', icon: '⚠', class: 'status-slushy' },
  freeze: { text: 'Will Freeze', icon: '✗', class: 'status-freeze' }
};

const status = statusLabels[displayFreezeStatus as keyof typeof statusLabels];

// Recipe schema for SEO
const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": `Freezer Batch ${cocktail.name}`,
  "description": cocktail.description,
  "recipeCategory": "Cocktail",
  "recipeCuisine": "American",
  "recipeYield": `${cocktail.servings} servings`,
  "prepTime": `PT${parseInt(cocktail.prepTime)}M`,
  "totalTime": `PT${parseInt(cocktail.prepTime) + 240}M`,
  "recipeIngredient": cocktail.recipe.single.map(
    (ing: any) => `${ing.volumeMl}ml ${ing.name}`
  ),
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Calculate your batch using the calculator above, or follow the pre-calculated amounts."
    },
    {
      "@type": "HowToStep",
      "text": "Pour off the calculated amount from your base spirit bottle to make room."
    },
    {
      "@type": "HowToStep",
      "text": "Add each ingredient to the bottle using a funnel."
    },
    {
      "@type": "HowToStep",
      "text": "Add the dilution water if specified."
    },
    {
      "@type": "HowToStep",
      "text": "Seal and shake well to combine."
    },
    {
      "@type": "HowToStep",
      "text": `Freeze for ${cocktail.freezeTime}.`
    },
    {
      "@type": "HowToStep",
      "text": cocktail.serve
    }
  ],
  "keywords": cocktail.seo.keywords.join(", "),
  "nutrition": {
    "@type": "NutritionInformation",
    "servingSize": "1 cocktail"
  }
};
---

<Layout
  title={cocktail.seo.title.replace('Freezer Door', 'Freezer Batch')}
  description={cocktail.seo.description}
  schema={recipeSchema}
>
  <article class="py-8 sm:py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Breadcrumb -->
      <nav class="mb-6 text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href="/" class="text-gray-500 hover:text-primary">Home</a></li>
          <li class="text-gray-400">/</li>
          <li><a href="/cocktails" class="text-gray-500 hover:text-primary">Cocktails</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-charcoal font-medium">{cocktail.name}</li>
        </ol>
      </nav>

      <!-- Header — title and metadata, with the served-glass illustration as
           a small visual anchor on the right. -->
      <header class="mb-8 flex items-start gap-6">
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-medium border ${status.class}`}>
              <span>{status.icon}</span>
              {status.text}
            </span>
            {cocktail.reliability === 'bulletproof' && (
              <span class="bg-primary-100 text-primary-700 px-3 py-1 rounded-full text-sm font-medium" title="Spirit-forward — keeps for months in the freezer">
                Lasts months
              </span>
            )}
          </div>

          <h1 class="text-3xl sm:text-4xl font-bold text-charcoal mb-3">
            {cocktail.name}
          </h1>
          <p class="text-lg text-gray-600">{cocktail.tagline}</p>
        </div>

        <!-- Served-in glass illustration -->
        <div class="hidden sm:flex shrink-0 w-20 h-20 items-center justify-center rounded-2xl bg-cream-200 border border-cognac-200/60 text-primary-600" title={`Served in a ${glassType} glass`}>
          <GlassIcon type={glassType} class="w-12 h-12" />
        </div>
      </header>

      <!-- Quick Stats Bar — grouped: Yield (ABV / Drinks) and Time (Prep / Freeze)
           with a divider between so the eye reads them as two pairs. -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-0 p-4 bg-gray-50 rounded-xl mb-8 sm:divide-x sm:divide-cognac-200/60">
        <div class="grid grid-cols-2 gap-4 flex-1 sm:pr-4">
          <div class="text-center">
            <span class="block text-xl font-bold font-mono text-primary-600">{displayAbv}%</span>
            <span class="text-xs uppercase tracking-wider text-cognac-400">ABV</span>
          </div>
          <div class="text-center">
            <span class="block text-xl font-bold font-mono text-primary-600">{displayServings}</span>
            <span class="text-xs uppercase tracking-wider text-cognac-400">Drinks</span>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 flex-1 sm:pl-4 border-t border-cognac-200/60 pt-3 sm:border-t-0 sm:pt-0">
          <div class="text-center">
            <span class="block text-xl font-bold font-mono text-cognac">{cocktail.prepTime}</span>
            <span class="text-xs uppercase tracking-wider text-cognac-400">Prep</span>
          </div>
          <div class="text-center">
            <span class="block text-xl font-bold font-mono text-cognac">{cocktail.freezeTime}</span>
            <span class="text-xs uppercase tracking-wider text-cognac-400">Freeze</span>
          </div>
        </div>
      </div>

      <!-- About — above the calculator so the user has context for what
           they're batching before they start. Editorial deck treatment so
           it reads as a deliberate intro, not stray text. -->
      <section class="mb-10">
        <p class="article-eyebrow mb-4">About this cocktail</p>
        <p class="font-display text-lg sm:text-xl leading-relaxed text-cognac-800 max-w-2xl">
          {cocktail.description}
        </p>
      </section>

      <!-- Calculator — the main act. -->
      <section class="mb-10">
        <Calculator cocktailSlug={cocktail.slug} />
      </section>

      <!-- How to Serve — what to do once your batch is frozen. -->
      <section class="mb-8 p-5 sm:p-6 bg-primary-50 rounded-xl border border-primary-100">
        <h2 class="font-display text-xl font-semibold text-charcoal mb-2">How to serve</h2>
        <p class="text-gray-700">{cocktail.serve}</p>
        {cocktail.shelfLife && (
          <p class="mt-3 text-sm text-cognac-500">
            <strong class="text-cognac">Best within:</strong> {cocktail.shelfLife}
          </p>
        )}
      </section>

      <!-- Tips + Common Mistakes — side by side on desktop, stacked on mobile.
           Both are pre-batch guidance the user wants to glance at quickly. -->
      <section class="grid md:grid-cols-2 gap-5 mb-10">
        {cocktail.tips && cocktail.tips.length > 0 && (
          <div class="p-5 bg-white rounded-xl border border-cognac-200/60 shadow-sm">
            <h2 class="font-display text-lg font-semibold text-charcoal mb-3 flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-accent-100 text-accent-700 text-sm">★</span>
              Pro tips
            </h2>
            <ul class="space-y-2.5">
              {cocktail.tips.map((tip: string) => (
                <li class="flex gap-2 text-sm text-cognac">
                  <span class="text-accent-500 flex-shrink-0 font-bold mt-0.5">+</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {cocktail.commonMistakes && cocktail.commonMistakes.length > 0 && (
          <div class="p-5 bg-white rounded-xl border border-cognac-200/60 shadow-sm">
            <h2 class="font-display text-lg font-semibold text-charcoal mb-3 flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-danger/15 text-danger text-sm">!</span>
              Avoid these
            </h2>
            <ul class="space-y-2.5">
              {cocktail.commonMistakes.map((mistake: string) => (
                <li class="flex gap-2 text-sm text-cognac">
                  <span class="text-danger flex-shrink-0 mt-0.5">−</span>
                  <span>{mistake}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <!-- Event Planning CTA -->
      <section class="mb-10">
        <a href="https://www.stocktheevent.com" target="_blank" rel="noopener" class="block group">
          <div class="p-5 bg-gradient-to-r from-accent-50 to-primary-50 rounded-xl border border-accent-200 hover:border-accent-400 transition-all">
            <div class="flex items-center gap-4">
              <div class="text-3xl">🎉</div>
              <div class="flex-1">
                <p class="font-semibold text-surface-900 group-hover:text-primary-700 transition-colors">
                  Batching for a party?
                </p>
                <p class="text-sm text-surface-600">
                  Find out exactly how much wine, beer, and spirits to buy for your guest count.
                </p>
              </div>
              <svg class="w-5 h-5 text-surface-400 group-hover:text-primary-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      </section>

      <!-- Recommended Tools (Affiliate Links) -->
      {cocktail.affiliateProducts && cocktail.affiliateProducts.length > 0 && (
        <section class="mb-10 p-6 bg-white rounded-xl border border-gray-200">
          <h2 class="text-xl font-bold text-charcoal mb-4">Recommended Tools</h2>
          <ul class="space-y-3">
            {cocktail.affiliateProducts.map((product: any) => (
              <li>
                <AffiliateLink
                  asin={product.asin}
                  text={product.name}
                  category={product.category}
                />
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs text-gray-400">
            As an Amazon Associate we earn from qualifying purchases
          </p>
        </section>
      )}
    </div>

    <!-- Related Cocktails - Full Width -->
    {relatedCocktails.length > 0 && (
      <section class="mt-16 pt-12 border-t bg-gray-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
          <h2 class="text-2xl font-bold text-charcoal mb-8">You Might Also Like</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedCocktails.map(related => (
              <CocktailCard
                slug={related.slug}
                name={related.name}
                tagline={related.tagline}
                baseSpirit={related.baseSpirit}
                reliability={related.reliability as 'bulletproof' | 'needs-attention'}
                finalAbv={related.finalAbv}
                freezeStatus={related.freezeStatus as 'freeze' | 'slushy' | 'safe'}
                servings={related.servings}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>
