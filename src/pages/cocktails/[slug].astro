---
import Layout from '../../layouts/Layout.astro';
import Calculator from '../../components/Calculator.astro';
import CocktailCard from '../../components/CocktailCard.astro';
import AffiliateLink from '../../components/AffiliateLink.astro';
import GlassIcon from '../../components/GlassIcon.astro';
import type { GlassType } from '../../components/GlassIcon.astro';
import cocktailsData from '../../data/cocktails.json';
import { calculateMilkStreetBatch, MILK_STREET_BATCHES } from '../../lib/calculator';

// Map each cocktail to the glass it's traditionally served in. Used to
// give each recipe page a small piece of visual identity without photos.
const GLASS_BY_SLUG: Record<string, GlassType> = {
  negroni: 'rocks',
  manhattan: 'coupe',
  'old-fashioned': 'rocks',
  boulevardier: 'rocks',
  'dirty-martini': 'coupe',
  margarita: 'coupe',
  cosmopolitan: 'coupe',
  'moscow-mule': 'mug',
  'espresso-martini': 'coupe',
  'paper-plane': 'coupe',
  daiquiri: 'coupe',
  vesper: 'coupe',
  'mint-julep': 'julep',
  'vieux-carre': 'rocks',
  'hanky-panky': 'coupe',
  aviation: 'coupe',
  sazerac: 'rocks',
  bijou: 'coupe',
};

export function getStaticPaths() {
  return cocktailsData.cocktails.map(cocktail => ({
    params: { slug: cocktail.slug },
    props: { cocktail }
  }));
}

const { cocktail } = Astro.props;

// Single source of truth for ABV / servings: derive from the same
// calculator the user interacts with below. Falls back to the JSON
// value for cocktails that don't have a Milk Street batch defined.
const liveBatch = MILK_STREET_BATCHES[cocktail.slug]
  ? calculateMilkStreetBatch(cocktail.slug, 750)
  : null;
const displayAbv = liveBatch ? Math.round(liveBatch.finalAbv) : cocktail.finalAbv;
const displayServings = liveBatch ? liveBatch.servings : cocktail.servings;
const displayFreezeStatus = liveBatch ? liveBatch.freezeStatus : cocktail.freezeStatus;
const glassType: GlassType = GLASS_BY_SLUG[cocktail.slug] ?? 'coupe';

// Get related cocktails
const relatedCocktails = cocktailsData.cocktails
  .filter(c => cocktail.relatedCocktails?.includes(c.slug))
  .slice(0, 3);

const statusLabels = {
  safe: { text: 'Freezer Safe', icon: '✓', class: 'status-safe' },
  slushy: { text: 'Slushy', icon: '⚠', class: 'status-slushy' },
  freeze: { text: 'Will Freeze', icon: '✗', class: 'status-freeze' }
};

const status = statusLabels[displayFreezeStatus as keyof typeof statusLabels];

// Recipe schema for SEO
const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": `Freezer Batch ${cocktail.name}`,
  "description": cocktail.description,
  "recipeCategory": "Cocktail",
  "recipeCuisine": "American",
  "recipeYield": `${cocktail.servings} servings`,
  "prepTime": `PT${parseInt(cocktail.prepTime)}M`,
  "totalTime": `PT${parseInt(cocktail.prepTime) + 240}M`,
  "recipeIngredient": cocktail.recipe.single.map(
    (ing: any) => `${ing.volumeMl}ml ${ing.name}`
  ),
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Calculate your batch using the calculator above, or follow the pre-calculated amounts."
    },
    {
      "@type": "HowToStep",
      "text": "Pour off the calculated amount from your base spirit bottle to make room."
    },
    {
      "@type": "HowToStep",
      "text": "Add each ingredient to the bottle using a funnel."
    },
    {
      "@type": "HowToStep",
      "text": "Add the dilution water if specified."
    },
    {
      "@type": "HowToStep",
      "text": "Seal and shake well to combine."
    },
    {
      "@type": "HowToStep",
      "text": `Freeze for ${cocktail.freezeTime}.`
    },
    {
      "@type": "HowToStep",
      "text": cocktail.serve
    }
  ],
  "keywords": cocktail.seo.keywords.join(", "),
  "nutrition": {
    "@type": "NutritionInformation",
    "servingSize": "1 cocktail"
  }
};
---

<Layout
  title={cocktail.seo.title.replace('Freezer Door', 'Freezer Batch')}
  description={cocktail.seo.description}
  schema={recipeSchema}
>
  <article class="py-12 sm:py-16">
    <div class="max-w-[920px] mx-auto px-6 sm:px-10 lg:px-20">

      <!-- Breadcrumb -->
      <nav class="mb-8 text-[11px] uppercase tracking-[0.2em]" aria-label="Breadcrumb">
        <ol class="flex items-center gap-3 text-study-muted">
          <li><a href="/" class="hover:text-accent-500 transition-colors">Home</a></li>
          <li class="text-study-border-light">/</li>
          <li><a href="/cocktails" class="hover:text-accent-500 transition-colors">Recipes</a></li>
          <li class="text-study-border-light">/</li>
          <li class="text-cream-200">{cocktail.name}</li>
        </ol>
      </nav>

      <!-- Header — title and metadata, with the glass illustration -->
      <header class="mb-10 flex items-start gap-8">
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-[10px] uppercase tracking-[0.18em] font-medium border ${status.class}`}>
              <span>{status.icon}</span>
              {status.text}
            </span>
            {cocktail.reliability === 'bulletproof' && (
              <span class="px-3 py-1 text-[10px] uppercase tracking-[0.18em] font-medium border border-accent-500/40 text-accent-300 bg-accent-500/5" title="Spirit-forward — keeps for months in the freezer">
                Lasts months
              </span>
            )}
          </div>

          <h1 class="font-display italic text-cream-100 font-normal mb-3" style="font-size: clamp(2.5rem, 5vw, 3.75rem); line-height: 1.05;">
            {cocktail.name}
          </h1>
          <p class="font-display italic text-[20px] sm:text-[22px] text-cognac-700 font-normal">
            {cocktail.tagline}
          </p>
        </div>

        <!-- Glass illustration — brass on dark -->
        <div class="hidden sm:flex shrink-0 w-24 h-24 items-center justify-center bg-study-card border border-study-border text-accent-500" title={`Served in a ${glassType} glass`}>
          <GlassIcon type={glassType} class="w-14 h-14" />
        </div>
      </header>

      <!-- Quick Stats Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-0 mb-12 border-t border-b border-study-border py-6">
        <div class="text-center sm:border-r sm:border-study-border">
          <span class="block font-display italic text-[36px] text-accent-500 font-light leading-none">{displayAbv}<span class="text-[18px]">%</span></span>
          <span class="block text-[10px] uppercase tracking-[0.2em] text-study-muted mt-2 font-medium">ABV</span>
        </div>
        <div class="text-center sm:border-r sm:border-study-border">
          <span class="block font-display italic text-[36px] text-cream-100 font-light leading-none">{displayServings}</span>
          <span class="block text-[10px] uppercase tracking-[0.2em] text-study-muted mt-2 font-medium">Drinks</span>
        </div>
        <div class="text-center sm:border-r sm:border-study-border border-t border-study-border pt-4 sm:border-t-0 sm:pt-0 mt-4 sm:mt-0">
          <span class="block font-display italic text-[28px] text-cream-100 font-light leading-none">{cocktail.prepTime}</span>
          <span class="block text-[10px] uppercase tracking-[0.2em] text-study-muted mt-2 font-medium">Prep</span>
        </div>
        <div class="text-center border-t border-study-border pt-4 sm:border-t-0 sm:pt-0 mt-4 sm:mt-0">
          <span class="block font-display italic text-[28px] text-cream-100 font-light leading-none">{cocktail.freezeTime}</span>
          <span class="block text-[10px] uppercase tracking-[0.2em] text-study-muted mt-2 font-medium">Freeze</span>
        </div>
      </div>

      <!-- About — editorial intro -->
      <section class="mb-12">
        <p class="article-eyebrow mb-5">About this cocktail</p>
        <p class="font-display text-[19px] sm:text-[21px] leading-[1.55] text-cognac-700 italic max-w-[640px] font-normal">
          {cocktail.description}
        </p>
      </section>

      <!-- Calculator -->
      <section class="mb-12">
        <Calculator cocktailSlug={cocktail.slug} />
      </section>

      <!-- How to Serve -->
      <section class="mb-10 p-6 sm:p-8 bg-study-card border border-study-border">
        <p class="section-eyebrow mb-3">At Serve</p>
        <h2 class="font-display italic text-[24px] text-cream-100 font-normal mb-4">How to serve</h2>
        <p class="text-[15px] text-cognac-700 leading-[1.7] font-light">{cocktail.serve}</p>
        {cocktail.shelfLife && (
          <p class="mt-4 text-[12px] uppercase tracking-[0.18em] text-study-muted">
            <strong class="text-accent-500 font-medium">Best within:</strong> {cocktail.shelfLife}
          </p>
        )}
      </section>

      <!-- Tips + Common Mistakes — side by side on desktop, stacked on mobile.
           Both are pre-batch guidance the user wants to glance at quickly. -->
      <section class="grid md:grid-cols-2 gap-5 mb-12">
        {cocktail.tips && cocktail.tips.length > 0 && (
          <div class="p-6 bg-study-card border border-study-border">
            <p class="section-eyebrow mb-3">Pro Tips</p>
            <ul class="space-y-3">
              {cocktail.tips.map((tip: string) => (
                <li class="flex gap-3 text-[14px] text-cognac-700 leading-[1.6] font-light">
                  <span class="text-accent-500 flex-shrink-0 font-medium mt-0.5">+</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {cocktail.commonMistakes && cocktail.commonMistakes.length > 0 && (
          <div class="p-6 bg-study-card border border-study-border">
            <p class="section-eyebrow mb-3" style="color:#ef4444;">Avoid These</p>
            <ul class="space-y-3">
              {cocktail.commonMistakes.map((mistake: string) => (
                <li class="flex gap-3 text-[14px] text-cognac-700 leading-[1.6] font-light">
                  <span class="text-danger flex-shrink-0 mt-0.5">−</span>
                  <span>{mistake}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <!-- Event Planning CTA -->
      <section class="mb-12">
        <a href="https://www.stocktheevent.com" target="_blank" rel="noopener" class="block group">
          <div class="p-6 bg-study-card border border-study-border hover:border-accent-500 transition-all">
            <div class="flex items-center gap-5">
              <div class="flex-1">
                <p class="section-eyebrow mb-2">For Hosts</p>
                <p class="font-display italic text-[20px] text-cream-100 group-hover:text-accent-300 transition-colors mb-1">
                  Batching for a party?
                </p>
                <p class="text-[13px] text-study-muted leading-[1.6] font-light">
                  Find out exactly how much wine, beer, and spirits to buy for your guest count.
                </p>
              </div>
              <svg class="w-5 h-5 text-study-muted group-hover:text-accent-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      </section>

      <!-- Recommended Tools -->
      {cocktail.affiliateProducts && cocktail.affiliateProducts.length > 0 && (
        <section class="mb-12 p-6 sm:p-8 bg-study-card border border-study-border">
          <p class="section-eyebrow mb-3">The Tools</p>
          <h2 class="font-display italic text-[24px] text-cream-100 font-normal mb-5">Recommended for this batch</h2>
          <ul class="space-y-3">
            {cocktail.affiliateProducts.map((product: any) => (
              <li>
                <AffiliateLink
                  asin={product.asin}
                  text={product.name}
                  category={product.category}
                />
              </li>
            ))}
          </ul>
          <p class="mt-5 text-[10px] uppercase tracking-[0.2em] text-study-muted/70">
            As an Amazon Associate we earn from qualifying purchases.
          </p>
        </section>
      )}
    </div>

    <!-- Related Cocktails -->
    {relatedCocktails.length > 0 && (
      <section class="mt-20 py-16 bg-study-card border-t border-study-border">
        <div class="max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-20">
          <p class="section-eyebrow mb-3">More to Try</p>
          <h2 class="font-display italic text-[32px] text-cream-100 font-normal mb-10">You might also like</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedCocktails.map(related => (
              <CocktailCard
                slug={related.slug}
                name={related.name}
                tagline={related.tagline}
                baseSpirit={related.baseSpirit}
                reliability={related.reliability as 'bulletproof' | 'needs-attention'}
                finalAbv={related.finalAbv}
                freezeStatus={related.freezeStatus as 'freeze' | 'slushy' | 'safe'}
                servings={related.servings}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>
