---
import Layout from '../layouts/Layout.astro';

const title = 'Unsubscribe';
const description = 'Unsubscribe from FreezerBatchCocktails.com emails';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
---

<Layout title={title} description={description}>
  <article class="py-12">
    <div class="max-w-md mx-auto px-4 sm:px-6">
      <div class="text-center mb-8">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4"><svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg></div>
        <h1 class="text-3xl font-bold text-charcoal mb-2">Unsubscribe</h1>
        <p class="text-gray-600">We're sorry to see you go!</p>
      </div>

      <unsubscribe-form class="block" data-turnstile-site-key={turnstileSiteKey}>
        <form id="unsubscribe-form" class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
          <div class="mb-4">
            <label for="email-input" class="block text-sm font-medium text-gray-700 mb-2">Enter your email address</label>
            <input type="email" id="email-input" name="email" required autocomplete="email" placeholder="you@example.com" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors" />
          </div>
          <button type="submit" id="submit-btn" class="w-full py-3 px-6 bg-gray-600 hover:bg-gray-700 text-white font-medium rounded-lg transition-colors flex items-center justify-center gap-2"><span id="btn-text">Unsubscribe</span><svg id="btn-spinner" class="w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg></button>
          <label class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          <div class="turnstile-container mt-4" aria-label="Verification challenge"></div>
          <p class="turnstile-note mt-2 text-xs text-gray-600" aria-live="polite"></p>
          <p id="form-status" class="hidden mt-4 text-sm text-center" role="status" aria-live="polite"></p>
        </form>
      </unsubscribe-form>
      <div class="mt-8 text-center"><p class="text-gray-500 text-sm mb-4">Changed your mind?</p><a href="/" class="text-primary-600 hover:text-primary-700 font-medium">Return to FreezerBatch</a></div>
    </div>
  </article>
</Layout>

<script>
  class UnsubscribeForm extends HTMLElement {
    private form: HTMLFormElement | null = null;
    private emailInput: HTMLInputElement | null = null;
    private submitBtn: HTMLButtonElement | null = null;
    private status: HTMLElement | null = null;
    private requestId: string | null = null;
    private widgetId: string | number | null = null;

    connectedCallback() {
      this.form = this.querySelector('#unsubscribe-form');
      this.emailInput = this.querySelector('#email-input');
      this.submitBtn = this.querySelector('#submit-btn');
      this.status = this.querySelector('#form-status');
      this.form?.addEventListener('submit', (event) => { event.preventDefault(); void this.handleSubmit(); });
      this.form?.addEventListener('input', () => { this.requestId = null; });
      this.initializeTurnstile();
    }

    private async loadTurnstile(): Promise<any> {
      if ((window as any).turnstile) return (window as any).turnstile;
      if ((window as any).__fbcTurnstilePromise) return (window as any).__fbcTurnstilePromise;
      (window as any).__fbcTurnstilePromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'; script.async = true; script.defer = true;
        script.onload = () => (window as any).turnstile ? resolve((window as any).turnstile) : reject(new Error('Turnstile did not load'));
        script.onerror = () => reject(new Error('Turnstile failed to load'));
        document.head.appendChild(script);
      });
      return (window as any).__fbcTurnstilePromise;
    }

    private initializeTurnstile() {
      const note = this.querySelector<HTMLElement>('.turnstile-note');
      const container = this.querySelector<HTMLElement>('.turnstile-container');
      const siteKey = this.dataset.turnstileSiteKey || '';
      if (!siteKey) {
        if (this.submitBtn) this.submitBtn.disabled = true;
        if (note) note.textContent = 'Unsubscribe requests are unavailable in local development because verification is not configured.';
        return;
      }
      if (!this.submitBtn || !container) return;
      this.submitBtn.disabled = true;
      if (note) note.textContent = 'Complete the verification challenge to unsubscribe.';
      void this.loadTurnstile().then((turnstile) => {
        this.widgetId = turnstile.render(container, {
          sitekey: siteKey,
          callback: (token: string) => { this.dataset.turnstileToken = token; if (this.submitBtn) this.submitBtn.disabled = false; if (note) note.textContent = ''; },
          'expired-callback': () => this.clearTurnstileToken(),
          'error-callback': () => this.clearTurnstileToken(),
        });
      }).catch(() => { if (note) note.textContent = 'Verification could not load. Please refresh and try again.'; });
    }

    private clearTurnstileToken() {
      delete this.dataset.turnstileToken;
      if (this.submitBtn) this.submitBtn.disabled = true;
      const note = this.querySelector<HTMLElement>('.turnstile-note');
      if (note) note.textContent = 'Please retry the verification challenge.';
    }

    private resetTurnstile() {
      this.clearTurnstileToken();
      if (this.widgetId !== null && (window as any).turnstile) (window as any).turnstile.reset(this.widgetId);
    }

    private errorMessage(code: string | undefined) {
      if (code === 'invalid_request') return 'Please check the form and try again.';
      if (code === 'verification_failed') return 'Please retry the challenge.';
      if (code === 'rate_limited') return 'Please try again in a minute.';
      if (code === 'upstream_unavailable') return "We'll be back shortly.";
      return 'Something went wrong. Please try again.';
    }

    private showStatus(message: string, success: boolean) {
      if (!this.status) return;
      this.status.textContent = message;
      this.status.className = `mt-4 text-sm text-center ${success ? 'text-green-700' : 'text-red-700'}`;
    }

    private async handleSubmit() {
      const email = this.emailInput?.value.trim();
      const turnstileToken = this.dataset.turnstileToken;
      if (!email || !turnstileToken || !this.submitBtn || this.submitBtn.disabled) return;
      this.requestId ||= crypto.randomUUID();
      this.submitBtn.disabled = true;
      try {
        const response = await fetch('/api/email', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'unsubscribe', requestId: this.requestId, email, page: window.location.pathname, turnstileToken, website: this.form?.querySelector<HTMLInputElement>('input[name="website"]')?.value || '' }),
        });
        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          if ([403, 429, 502].includes(response.status)) this.resetTurnstile();
          if (response.status === 400) this.requestId = null;
          throw new Error(typeof body.code === 'string' ? body.code : 'email_request_failed');
        }
        this.emailInput!.value = '';
        this.requestId = null;
        this.resetTurnstile();
        this.showStatus("You've been unsubscribed.", true);
      } catch (error) {
        if (error instanceof TypeError) this.resetTurnstile();
        this.showStatus(this.errorMessage(error instanceof Error ? error.message : undefined), false);
      } finally {
        if (this.submitBtn) this.submitBtn.disabled = !this.dataset.turnstileToken;
      }
    }
  }
  customElements.define('unsubscribe-form', UnsubscribeForm);
</script>
