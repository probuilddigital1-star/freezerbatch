---
import Layout from '../../layouts/Layout.astro';

const title = 'Guides';
const description = 'Practical guides for freezer-batching cocktails: dilution, sweetness, citrus, vermouth, and the rest of the small calls that make a batch land right.';

const posts = [
  {
    slug: 'why-your-batch-is-too-sweet',
    title: 'Why your freezer batch is too sweet (and how to fix it)',
    hook: 'Cold drinks taste different from room-temperature drinks. The trick the freezer plays on sugar, and how much to dial back.',
    readTime: '5 min',
  },
  {
    slug: 'fresh-citrus-in-batches',
    title: 'Fresh citrus in freezer batches',
    hook: 'Lemon and lime juice peak in the first 48 hours and fade after a week. How to size your batches around it.',
    readTime: '4 min',
  },
  {
    slug: 'choosing-vermouth',
    title: 'Choosing a vermouth (and knowing when it\'s dead)',
    hook: 'Vermouth is wine. It oxidizes. Picking the right one for the cocktail and a 30-second oxidation test for the bottle in your fridge.',
    readTime: '5 min',
  },
  {
    slug: 'dilution-guide',
    title: 'The freezer-batch dilution guide',
    hook: 'When to add water, when not to, and why 22% ABV is the line. Matching the calculator\'s 0% / 20% / 25% buttons to actual drinks.',
    readTime: '4 min',
  },
];
---

<Layout title={title} description={description}>
  <article class="py-20 sm:py-28">
    <div class="max-w-[820px] mx-auto px-6 sm:px-10 lg:px-20">
      <header class="text-center mb-16">
        <p class="section-eyebrow">The Guides</p>
        <h1 class="section-title italic">Short, sharp guides</h1>
        <p class="section-subtitle max-w-xl mx-auto">
          The small judgment calls behind a great freezer batch.
        </p>
      </header>

      <div class="space-y-5">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="group block bg-study-card border border-study-border p-8 hover:border-accent-500 transition-all">
            <div class="flex items-baseline justify-between gap-4 mb-3">
              <p class="text-[10px] uppercase tracking-[0.2em] text-accent-500 font-medium">{post.readTime} read</p>
              <span class="text-[10px] uppercase tracking-[0.2em] text-study-muted">Guide</span>
            </div>
            <h2 class="font-display italic text-[26px] sm:text-[28px] text-cream-100 group-hover:text-accent-300 transition-colors font-normal leading-[1.2] mb-3">
              {post.title}
            </h2>
            <p class="text-[15px] text-cognac-700 leading-[1.7] font-light mb-5">{post.hook}</p>
            <p class="text-[11px] uppercase tracking-[0.2em] text-study-muted group-hover:text-accent-500 inline-flex items-center gap-2 transition-colors">
              Read the guide
              <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            </p>
          </a>
        ))}
      </div>

      <div class="mt-20 text-center">
        <a href="/#calculator" class="btn-primary">Open the calculator</a>
      </div>
    </div>
  </article>
</Layout>
