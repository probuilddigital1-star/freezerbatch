---
const currentYear = new Date().getFullYear();
---

<footer class="bg-study-bg border-t border-study-border mt-auto relative z-10">
  <div class="max-w-[1280px] mx-auto px-6 sm:px-10 lg:px-20 pt-16 pb-12">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand column -->
      <div class="md:col-span-2">
        <a href="/" class="inline-block font-display text-[26px] font-semibold tracking-[0.02em] text-cream-100 mb-5">
          FREEZER<span class="text-accent-500">BATCH</span>
        </a>
        <p class="text-study-muted text-[15px] leading-[1.7] max-w-sm font-light">
          Pre-batch cocktails that stay perfectly pourable in your freezer.
          Do the math once, drink well forever.
        </p>
        <div class="mt-6">
          <a
            href="https://www.instagram.com/freezerbatchcocktails/"
            target="_blank"
            rel="noopener"
            aria-label="Freezer Batch Cocktails on Instagram"
            class="inline-flex items-center justify-center p-2 -m-2 text-study-muted hover:text-accent-500 transition-colors"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
              <circle cx="12" cy="12" r="4.5" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-[11px] uppercase tracking-[0.3em] text-accent-500 font-medium mb-5">Navigate</h3>
        <ul class="space-y-3">
          <li><a href="/" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">Home</a></li>
          <li><a href="/cocktails" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">All Recipes</a></li>
          <li><a href="/blog" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">Guides</a></li>
          <li><a href="/how-it-works" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">Method</a></li>
        </ul>
      </div>

      <!-- Popular recipes -->
      <div>
        <h3 class="text-[11px] uppercase tracking-[0.3em] text-accent-500 font-medium mb-5">Classics</h3>
        <ul class="space-y-3">
          <li><a href="/cocktails/negroni" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">Negroni</a></li>
          <li><a href="/cocktails/manhattan" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">Manhattan</a></li>
          <li><a href="/cocktails/old-fashioned" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">Old Fashioned</a></li>
          <li><a href="/cocktails/sazerac" class="text-[14px] text-study-muted hover:text-cream-100 transition-colors">Sazerac</a></li>
        </ul>
      </div>
    </div>

    <!-- Responsible drinking notice -->
    <div class="mt-14 pt-8 border-t border-study-border">
      <p class="text-[12px] text-study-muted leading-[1.7] text-center sm:text-left max-w-3xl">
        FreezerBatchCocktails is intended for readers
        <strong class="text-cream-100 font-medium">21 and older</strong>
        (or the legal drinking age in your country). Please drink responsibly. Never drink and drive. If you or someone you know needs help, call the SAMHSA National Helpline at
        <a href="tel:18006624357" class="underline hover:text-accent-500">1-800-662-4357</a>.
      </p>
    </div>

    <!-- Legal links -->
    <div class="mt-8 flex flex-wrap items-center justify-center sm:justify-start gap-x-8 gap-y-2 text-[12px] uppercase tracking-[0.2em] text-study-muted">
      <a href="/about" class="hover:text-cream-100 transition-colors">About</a>
      <a href="/privacy" class="hover:text-cream-100 transition-colors">Privacy</a>
      <a href="/terms" class="hover:text-cream-100 transition-colors">Terms</a>
      <a href="mailto:hello@freezerbatchcocktails.com" class="hover:text-cream-100 transition-colors">Contact</a>
    </div>

    <!-- Bottom -->
    <div class="mt-8 pt-6 border-t border-study-border/50 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-[12px] text-study-muted">© {currentYear} FreezerBatchCocktails.com</p>
      <p class="text-[11px] text-study-muted/70 text-center sm:text-right max-w-md">
        Some links are affiliate links. We may earn a commission at no extra cost to you.
      </p>
    </div>
  </div>
</footer>
