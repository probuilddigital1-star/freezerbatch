---
/**
 * Cocktail Card — The Study (dark editorial)
 * Dark surface, brass-on-active border, italic Cormorant cocktail name.
 */

export interface Props {
  slug: string;
  name: string;
  tagline: string;
  baseSpirit: string[];
  reliability: 'bulletproof' | 'needs-attention';
  finalAbv: number;
  freezeStatus: 'freeze' | 'slushy' | 'safe';
  servings: number;
  technique?: 'stirred' | 'shaken' | string;
}

const {
  slug,
  name,
  tagline,
  baseSpirit,
  reliability,
  finalAbv,
  freezeStatus,
  servings,
  technique,
} = Astro.props;

const statusConfig = {
  safe: { label: 'Freezer Safe', class: 'text-success border-success/30' },
  slushy: { label: 'Slushy', class: 'text-amber-400 border-warning/30' },
  freeze: { label: 'Will Freeze', class: 'text-danger border-danger/30' }
};

const status = statusConfig[freezeStatus];
---

<a
  href={`/cocktails/${slug}`}
  class="recipe-card group block bg-study-card border border-study-border p-10 transition-all duration-300 hover:border-accent-500"
>
  <!-- Eyebrow: spirit · technique -->
  <div class="flex items-center justify-between gap-3 mb-5">
    <span class="text-[11px] uppercase tracking-[0.2em] text-accent-500 font-medium">
      {baseSpirit.join(' · ')}{technique ? ` · ${technique}` : ''}
    </span>
    <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.18em] font-medium border ${status.class} bg-study-bg/30`}>
      {status.label}
    </span>
  </div>

  <!-- Name (Cormorant italic) -->
  <h3 class="font-display text-[28px] leading-tight text-cream-100 italic mb-3 font-normal">
    {name}
  </h3>

  <!-- Tagline -->
  <p class="text-[14px] leading-[1.7] text-study-muted font-light mb-7 line-clamp-2">
    {tagline}
  </p>

  <!-- Stats row -->
  <div class="flex items-baseline gap-6 mb-8">
    <div>
      <span class="block font-display text-[32px] text-accent-500 font-light leading-none">{finalAbv}<span class="text-[18px] ml-0.5">%</span></span>
      <span class="block text-[10px] uppercase tracking-[0.18em] text-study-muted mt-1.5">ABV</span>
    </div>
    <div class="w-px h-12 bg-study-border"></div>
    <div>
      <span class="block font-display text-[32px] text-cream-100 font-light leading-none">{servings}</span>
      <span class="block text-[10px] uppercase tracking-[0.18em] text-study-muted mt-1.5">Servings</span>
    </div>
  </div>

  <!-- Footer link -->
  <div class="flex items-center justify-between pt-5 border-t border-study-border">
    {reliability === 'bulletproof' ? (
      <span class="text-[10px] uppercase tracking-[0.2em] text-study-muted font-light" title="Spirit-forward — keeps for months in the freezer">
        Lasts months
      </span>
    ) : (
      <span class="text-[10px] uppercase tracking-[0.2em] text-amber-500/80 font-light" title="Contains fresh citrus or coffee — flavor peaks early">
        Best within a week
      </span>
    )}
    <span class="text-[11px] uppercase tracking-[0.2em] text-study-muted group-hover:text-accent-500 transition-colors flex items-center gap-2">
      Calculate batch
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
