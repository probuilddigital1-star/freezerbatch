---
/**
 * Cocktail Card — The Study (dark editorial)
 * Dark surface, brass-on-active border, italic Cormorant cocktail name.
 */

import { photoSources } from '../lib/recipePhotos';

// Quality window — how long the batch is at its best. Independent of freezeStatus,
// which answers the different question of whether it freezes solid.
export type Storage = {
  bestWithin: 'months' | 'weeks' | 'week';
  bestWithinLabel: string;
  limitedBy: 'citrus' | 'coffee' | 'vermouth' | 'mint' | null;
  note: string;
};

export interface Props {
  slug: string;
  name: string;
  tagline: string;
  baseSpirit: string[];
  storage: Storage;
  finalAbv: number;
  freezeStatus: 'freeze' | 'slushy' | 'safe';
  /** Safe, but clears the 22% line by only a few points. */
  nearLine?: boolean;
  servings: number;
  technique?: 'stirred' | 'shaken' | string;
}

const {
  slug,
  name,
  tagline,
  baseSpirit,
  storage,
  finalAbv,
  freezeStatus,
  nearLine = false,
  servings,
  technique,
} = Astro.props;

const statusConfig = {
  safe: { label: 'Freezer Safe', class: 'text-success border-success/30' },
  slushy: { label: 'Slushy', class: 'text-amber-400 border-warning/30' },
  freeze: { label: 'Will Freeze', class: 'text-danger border-danger/30' }
};

// Safe-but-near-the-line keeps the freezer-safe claim honest: pourable, but
// only just, so the pill goes amber and says so.
const status = freezeStatus === 'safe' && nearLine
  ? { label: 'Close to the line', class: 'text-amber-400 border-warning/30' }
  : statusConfig[freezeStatus];
const photo = photoSources(slug);

// The label itself is the claim — rendered verbatim so no surface can drift from
// storage.bestWithinLabel. Only the emphasis changes with the window.
const storageClass = {
  months: 'text-study-muted',
  weeks: 'text-amber-500/70',
  week: 'text-amber-500/90',
}[storage.bestWithin];
---

<a
  href={`/cocktails/${slug}`}
  class="recipe-card group block bg-study-card border border-study-border p-10 transition-all duration-300 hover:border-accent-500"
>
  <!-- Photo — only the 10 shot recipes have one; everything else renders unchanged. -->
  {photo && (
    <div class="-mx-10 -mt-10 mb-6 overflow-hidden">
      <picture>
        <source srcset={photo.webp760} type="image/webp" />
        <img
          src={photo.jpg760}
          width="760"
          height="950"
          alt={`${name}, a freezer batch ${baseSpirit.join(' and ')} cocktail`}
          loading="lazy"
          decoding="async"
          class="w-full h-auto object-cover aspect-[4/5]"
        />
      </picture>
    </div>
  )}

  <!-- Eyebrow: spirit · technique -->
  <div class="flex items-center justify-between gap-3 mb-5">
    <span class="text-[11px] uppercase tracking-[0.2em] text-accent-500 font-medium">
      {baseSpirit.join(' · ')}{technique ? ` · ${technique}` : ''}
    </span>
    <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.18em] font-medium border ${status.class} bg-study-bg/30`}>
      {status.label}
    </span>
  </div>

  <!-- Name (Cormorant italic) -->
  <h3 class="font-display text-[28px] leading-tight text-cream-100 italic mb-3 font-normal">
    {name}
  </h3>

  <!-- Tagline -->
  <p class="text-[14px] leading-[1.7] text-study-muted font-light mb-7 line-clamp-2">
    {tagline}
  </p>

  <!-- Stats row -->
  <div class="flex items-baseline gap-6 mb-8">
    <div>
      <span class="block font-display text-[32px] text-accent-500 font-light leading-none">{finalAbv}<span class="text-[18px] ml-0.5">%</span></span>
      <span class="block text-[10px] uppercase tracking-[0.18em] text-study-muted mt-1.5">ABV</span>
    </div>
    <div class="w-px h-12 bg-study-border"></div>
    <div>
      <span class="block font-display text-[32px] text-cream-100 font-light leading-none">{servings}</span>
      <span class="block text-[10px] uppercase tracking-[0.18em] text-study-muted mt-1.5">Servings</span>
    </div>
  </div>

  <!-- Footer link -->
  <div class="flex items-center justify-between pt-5 border-t border-study-border">
    <span class={`text-[10px] uppercase tracking-[0.2em] font-light ${storageClass}`} title={storage.note}>
      Best within {storage.bestWithinLabel}
    </span>
    <span class="text-[11px] uppercase tracking-[0.2em] text-study-muted group-hover:text-accent-500 transition-colors flex items-center gap-2">
      Calculate batch
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
