---
/**
 * Email Signup CTA — The Study (dark editorial)
 * Centered layout, dark input, brass subscribe button.
 */

export interface Props {
  headline?: string;
  subheadline?: string;
  buttonText?: string;
  /** kept for API compatibility; The Study uses a single dark variant */
  variant?: 'default' | 'dark' | 'gradient';
}

const {
  headline = "Join the batch",
  subheadline = "New recipes, freezer hacks, and the occasional spirit recommendation.",
  buttonText = "Subscribe",
} = Astro.props;

const webhookUrl = "https://zax76.app.n8n.cloud/webhook/freezerbatch-email";
---

<email-signup-form class="block" data-webhook={webhookUrl}>
  <div class="max-w-xl mx-auto text-center px-6 sm:px-10 py-12 sm:py-16">

    <p class="section-eyebrow">Newsletter</p>

    <h3 class="font-display text-[36px] sm:text-[44px] text-cream-100 italic font-normal leading-tight mb-4">
      {headline}
    </h3>

    <p class="text-[15px] text-study-muted font-light mb-10">
      {subheadline}
    </p>

    <form id="signup-form" class="flex flex-col sm:flex-row gap-3">
      <input
        type="email"
        id="email-input"
        name="email"
        placeholder="Your email"
        required
        class="flex-1 px-5 py-4 bg-study-card border border-study-border text-cream-100 placeholder:text-study-muted text-[14px] focus:border-accent-500 focus:outline-none transition-colors"
      />
      <button
        type="submit"
        id="submit-btn"
        class="btn-primary disabled:opacity-50 disabled:cursor-not-allowed sm:min-w-[160px]"
      >
        <span id="btn-text">{buttonText}</span>
        <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </button>
    </form>

    <!-- Success -->
    <div id="success-message" class="hidden mt-6">
      <div class="inline-flex items-center gap-2 text-success text-[13px] font-medium uppercase tracking-[0.15em]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>You're in. Check your inbox.</span>
      </div>
    </div>

    <!-- Error -->
    <div id="error-message" class="hidden mt-6">
      <div class="inline-flex items-center gap-2 text-danger text-[13px] font-medium uppercase tracking-[0.15em]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="error-text">Something went wrong. Please try again.</span>
      </div>
    </div>

    <p class="mt-8 text-[11px] uppercase tracking-[0.2em] text-study-muted/70">
      No spam, ever. <a href="/privacy" class="hover:text-accent-500 underline-offset-4 underline">Privacy</a>
    </p>
  </div>
</email-signup-form>

<script>
  class EmailSignupForm extends HTMLElement {
    private form: HTMLFormElement | null;
    private emailInput: HTMLInputElement | null;
    private submitBtn: HTMLButtonElement | null;
    private btnText: HTMLElement | null;
    private btnSpinner: HTMLElement | null;
    private successMessage: HTMLElement | null;
    private errorMessage: HTMLElement | null;
    private errorText: HTMLElement | null;
    private webhookUrl: string;

    constructor() {
      super();
      this.form = null;
      this.emailInput = null;
      this.submitBtn = null;
      this.btnText = null;
      this.btnSpinner = null;
      this.successMessage = null;
      this.errorMessage = null;
      this.errorText = null;
      this.webhookUrl = '';
    }

    connectedCallback() {
      this.form = this.querySelector('#signup-form');
      this.emailInput = this.querySelector('#email-input');
      this.submitBtn = this.querySelector('#submit-btn');
      this.btnText = this.querySelector('#btn-text');
      this.btnSpinner = this.querySelector('#btn-spinner');
      this.successMessage = this.querySelector('#success-message');
      this.errorMessage = this.querySelector('#error-message');
      this.errorText = this.querySelector('#error-text');
      this.webhookUrl = this.dataset.webhook || '';

      this.form?.addEventListener('submit', (e) => this.handleSubmit(e));
    }

    private async handleSubmit(e: Event) {
      e.preventDefault();
      if (!this.emailInput || !this.submitBtn) return;
      const email = this.emailInput.value.trim();
      if (!email) return;

      this.setLoading(true);
      this.hideMessages();

      try {
        const response = await fetch(this.webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            source: 'freezerbatchcocktails.com',
            timestamp: new Date().toISOString(),
            page: window.location.pathname,
          }),
        });
        if (!response.ok) throw new Error('Signup failed');
        this.showSuccess();
        this.emailInput.value = '';
      } catch (error) {
        console.error('Email signup error:', error);
        this.showError('Something went wrong. Please try again.');
      } finally {
        this.setLoading(false);
      }
    }

    private setLoading(loading: boolean) {
      if (!this.submitBtn || !this.btnText || !this.btnSpinner) return;
      this.submitBtn.disabled = loading;
      this.btnText.textContent = loading ? 'Sending…' : 'Subscribe';
      this.btnSpinner.classList.toggle('hidden', !loading);
    }

    private hideMessages() {
      this.successMessage?.classList.add('hidden');
      this.errorMessage?.classList.add('hidden');
    }

    private showSuccess() {
      this.form?.classList.add('hidden');
      this.successMessage?.classList.remove('hidden');
    }

    private showError(message: string) {
      if (this.errorText) this.errorText.textContent = message;
      this.errorMessage?.classList.remove('hidden');
    }
  }

  customElements.define('email-signup-form', EmailSignupForm);
</script>
