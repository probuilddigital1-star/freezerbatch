---
// Cold Open by FBC — on-site capture module.
// Variant A ('card') sits at the end of a recipe page; variant B ('footer') is the
// homepage one-liner. Both post to /api/email with action 'subscribe'; the behaviour
// below (Turnstile gating, honeypot, requestId reuse, analytics) is load-bearing and
// is shared verbatim by both variants.
export interface Props {
  variant?: 'card' | 'footer';
  programName?: string;
  ctaLabel?: string;
  headline?: string;
  promise?: string;
  reassurance?: string;
}

const {
  variant = 'card',
  programName = 'Cold Open',
  ctaLabel = variant === 'footer' ? 'Join' : 'Get the label sheet',
  headline = 'Ready before the guests arrive.',
  promise = 'One make-ahead recipe and a hosting timeline, monthly — plus the printable bottle-label sheet when you join.',
  reassurance = 'No spam. Unsubscribe anytime.',
} = Astro.props;

const footerBlurb = 'A recipe and a hosting timeline, monthly.';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const inputBase =
  'bg-study-elevated border border-study-border-light text-study-text placeholder:text-study-muted focus:border-study-accent focus:outline-none transition-colors';
const buttonBase =
  'bg-study-accent text-study-card font-sans font-semibold uppercase hover:bg-study-accent-hover disabled:opacity-50 disabled:cursor-not-allowed transition-colors';
---

<email-signup-form class="block" data-turnstile-site-key={turnstileSiteKey} data-variant={variant}>
  {variant === 'card' ? (
    <div class="cold-open-card max-w-[720px] mx-auto bg-study-card border border-study-border-light px-6 sm:px-[44px] py-8 sm:py-10 flex flex-col gap-5">
      <div class="flex flex-col items-start gap-3">
        <div class="flex items-center gap-[11px]">
          <span class="bg-study-accent text-study-card font-display font-semibold text-[13px] tracking-[0.06em] px-[7px] pt-1 pb-[3px] leading-none">FBC</span>
          <span class="font-display text-[19px] tracking-[0.18em] text-study-cream uppercase leading-none">{programName}</span>
        </div>
        <h3 class="font-display font-medium text-[26px] sm:text-[30px] text-study-cream leading-[1.25]">{headline}</h3>
        <p class="text-[15px] text-study-text leading-[1.6] max-w-[520px]">{promise}</p>
      </div>

      <form id="signup-form" class="flex gap-2.5 items-stretch flex-wrap">
        <label class="sr-only" for="email-input">Email address</label>
        <input type="email" id="email-input" name="email" placeholder="Email address" autocomplete="email" required
          class={`flex-1 min-w-[220px] px-4 py-[13px] text-[15px] ${inputBase}`} />
        <button type="submit" id="submit-btn" class={`px-[26px] py-[13px] text-[12px] tracking-[0.16em] ${buttonBase}`}>{ctaLabel}</button>
        <label class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </form>

      <div>
        <div class="turnstile-container" aria-label="Verification challenge"></div>
        <p class="turnstile-note mt-2 text-[13px] text-study-muted" aria-live="polite"></p>
        <p id="form-status" class="hidden mt-3 text-[13px]" role="status" aria-live="polite" tabindex="-1"></p>
      </div>

      <p class="text-[13px] text-study-muted">{reassurance}</p>
    </div>
  ) : (
    <div class="cold-open-footer border-t border-b border-study-border py-[18px]">
      <div class="flex items-center gap-3.5 flex-wrap">
        <span class="bg-study-accent text-study-card font-display font-semibold text-[12px] tracking-[0.06em] px-1.5 pt-[3px] pb-0.5 leading-none">FBC</span>
        <span class="font-display text-[16px] tracking-[0.16em] text-study-cream uppercase whitespace-nowrap leading-none">{programName}</span>
        <span class="text-[14px] text-study-muted">{footerBlurb}</span>

        <form id="signup-form" class="flex gap-2 flex-1 min-w-[280px] justify-end flex-wrap">
          <label class="sr-only" for="email-input">Email address</label>
          <input type="email" id="email-input" name="email" placeholder="Email address" autocomplete="email" required
            class={`w-[200px] px-3 py-[9px] text-[14px] ${inputBase}`} />
          <button type="submit" id="submit-btn" class={`px-[18px] py-[9px] text-[11px] tracking-[0.16em] ${buttonBase}`}>{ctaLabel}</button>
          <label class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </form>
      </div>

      <div class="mt-3 flex flex-col items-start gap-2 sm:items-end">
        <div class="turnstile-container" aria-label="Verification challenge"></div>
        <p class="turnstile-note text-[13px] text-study-muted" aria-live="polite"></p>
        <p id="form-status" class="hidden text-[13px]" role="status" aria-live="polite" tabindex="-1"></p>
        <p class="text-[13px] text-study-muted">{reassurance}</p>
      </div>
    </div>
  )}
</email-signup-form>

<script>
  import { pageType, track } from '../lib/analytics';

  class EmailSignupForm extends HTMLElement {
    private form: HTMLFormElement | null = null;
    private emailInput: HTMLInputElement | null = null;
    private submitBtn: HTMLButtonElement | null = null;
    private status: HTMLElement | null = null;
    private requestId: string | null = null;
    private widgetId: string | number | null = null;

    connectedCallback() {
      this.form = this.querySelector('#signup-form');
      this.emailInput = this.querySelector('#email-input');
      this.submitBtn = this.querySelector('#submit-btn');
      this.status = this.querySelector('#form-status');
      this.form?.addEventListener('submit', (event) => { event.preventDefault(); void this.handleSubmit(); });
      this.form?.addEventListener('input', () => { this.requestId = null; });
      this.initializeTurnstile();
    }

    private async loadTurnstile(): Promise<any> {
      if ((window as any).turnstile) return (window as any).turnstile;
      if ((window as any).__fbcTurnstilePromise) return (window as any).__fbcTurnstilePromise;
      (window as any).__fbcTurnstilePromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.defer = true;
        script.onload = () => (window as any).turnstile ? resolve((window as any).turnstile) : reject(new Error('Turnstile did not load'));
        script.onerror = () => reject(new Error('Turnstile failed to load'));
        document.head.appendChild(script);
      });
      return (window as any).__fbcTurnstilePromise;
    }

    private initializeTurnstile() {
      const note = this.querySelector<HTMLElement>('.turnstile-note');
      const container = this.querySelector<HTMLElement>('.turnstile-container');
      const siteKey = this.dataset.turnstileSiteKey || '';
      if (!siteKey) {
        if (this.submitBtn) this.submitBtn.disabled = true;
        if (note) note.textContent = 'Newsletter signup is unavailable in local development because verification is not configured.';
        return;
      }
      if (!this.submitBtn || !container) return;
      this.submitBtn.disabled = true;
      if (note) note.textContent = 'Complete the verification challenge to subscribe.';
      void this.loadTurnstile().then((turnstile) => {
        this.widgetId = turnstile.render(container, {
          sitekey: siteKey,
          callback: (token: string) => { this.dataset.turnstileToken = token; if (this.submitBtn) this.submitBtn.disabled = false; if (note) note.textContent = ''; },
          'expired-callback': () => this.clearTurnstileToken(),
          'error-callback': () => this.clearTurnstileToken(),
        });
      }).catch(() => { if (note) note.textContent = 'Verification could not load. Please refresh and try again.'; });
    }

    private setTurnstilePending(noteText = '') {
      delete this.dataset.turnstileToken;
      if (this.submitBtn) this.submitBtn.disabled = true;
      const note = this.querySelector<HTMLElement>('.turnstile-note');
      if (note) note.textContent = noteText;
    }

    private clearTurnstileToken() {
      this.setTurnstilePending('Please retry the verification challenge.');
    }

    private resetTurnstile() {
      this.setTurnstilePending();
      if (this.widgetId !== null && (window as any).turnstile) (window as any).turnstile.reset(this.widgetId);
    }

    private errorMessage(code: string | undefined) {
      if (code === 'invalid_request') return 'Please check the form and try again.';
      if (code === 'verification_failed') return 'Please retry the challenge.';
      if (code === 'rate_limited') return 'Please try again in a minute.';
      if (code === 'upstream_unavailable') return "We'll be back shortly.";
      return 'Something went wrong. Please try again.';
    }

    private showStatus(message: string, success: boolean) {
      if (!this.status) return;
      this.status.textContent = message;
      this.status.className = `mt-3 text-[13px] ${success ? 'text-success' : 'text-danger'}`;
      this.status.focus();
    }

    private async handleSubmit() {
      const email = this.emailInput?.value.trim();
      const turnstileToken = this.dataset.turnstileToken;
      if (!email || !turnstileToken || !this.submitBtn || this.submitBtn.disabled) return;
      this.requestId ||= crypto.randomUUID();
      this.submitBtn.disabled = true;
      try {
        const response = await fetch('/api/email', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'subscribe', requestId: this.requestId, email, consentVersion: '2026-07-23', page: window.location.pathname, turnstileToken, website: this.form?.querySelector<HTMLInputElement>('input[name="website"]')?.value || '' }),
        });
        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          if ([403, 429, 502].includes(response.status)) this.resetTurnstile();
          if (response.status === 400) this.requestId = null;
          throw new Error(typeof body.code === 'string' ? body.code : 'email_request_failed');
        }
        // Analytics: page type only — never the address.
        if (response.status === 202) {
          track('newsletter_optin', { page_type: pageType(window.location.pathname) });
        }

        this.emailInput!.value = '';
        this.requestId = null;
        this.resetTurnstile();
        this.showStatus("You're in. Your label sheet link is on its way.", true);
      } catch (error) {
        if (error instanceof TypeError) this.resetTurnstile();
        this.showStatus(this.errorMessage(error instanceof Error ? error.message : undefined), false);
      } finally {
        if (this.submitBtn) this.submitBtn.disabled = !this.dataset.turnstileToken;
      }
    }
  }
  customElements.define('email-signup-form', EmailSignupForm);
</script>
