---
/**
 * Interactive Batch Calculator Component
 *
 * Default mode is "preset" — most visitors want to batch a known cocktail,
 * not build something custom. The recipe picker is a visual tile grid so
 * users can scan rather than read a dropdown.
 */
import cocktailsData from '../data/cocktails.json';
import { MILK_STREET_BATCHES } from '../lib/calculator';

export interface Props {
  /** Pre-fill with a specific cocktail slug */
  cocktailSlug?: string;
  /** Simplified mode (hides advanced options) */
  simple?: boolean;
}

const { cocktailSlug, simple = false } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

// Only show recipes that have a Milk Street batch defined (the calculator
// can compute them). Order matches cocktails.json.
const recipeTiles = cocktailsData.cocktails
  .filter(c => MILK_STREET_BATCHES[c.slug])
  .map(c => ({
    slug: c.slug,
    name: c.name,
    baseSpirit: c.baseSpirit?.[0] ?? '',
    technique: c.recipe?.dilutionType ?? '',
  }));
---

<batch-calculator
  class="calculator-wrapper block"
  data-cocktail={cocktailSlug}
  data-simple={simple}
  data-turnstile-site-key={turnstileSiteKey}
>
  <div class="card">
    <p
      id="share-state-status"
      class="hidden mb-4 rounded-lg border border-cognac-200 bg-cognac-100/40 px-3 py-2 text-sm text-cognac"
      role="status"
      aria-live="polite"
    ></p>

    <!-- Entry Mode Toggle — preset is default (most users want a known recipe) -->
    <div class="mode-toggle-container relative bg-primary-100 rounded-2xl p-1.5 mb-6">
      <div class="mode-toggle-indicator absolute top-1.5 bottom-1.5 left-1.5 w-[calc(50%-3px)] bg-white rounded-xl shadow-lg transition-all duration-300 ease-out"></div>

      <div class="relative flex">
        <button
          type="button"
          class="entry-mode-btn flex-1 py-3 px-5 rounded-xl font-semibold transition-all z-10"
          data-mode="preset"
          aria-pressed="true"
        >
          Recipe
        </button>
        <button
          type="button"
          class="entry-mode-btn flex-1 py-3 px-5 rounded-xl font-semibold transition-all z-10"
          data-mode="custom"
          aria-pressed="false"
        >
          Custom
        </button>
      </div>
    </div>

    <!-- Preset Recipe Picker — visual tile grid, scannable like a menu -->
    <div id="preset-selector" class="mb-6">
      <p class="block text-sm font-medium text-gray-700 mb-3" id="recipe-picker-label">Pick a cocktail to batch</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2" role="radiogroup" aria-labelledby="recipe-picker-label">
        {recipeTiles.map(r => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            class="recipe-tile group text-left p-3 rounded-xl border-2 border-cognac-200 bg-white hover:border-accent-400 hover:shadow-md transition-all"
            data-recipe={r.slug}
          >
            <span class="block font-display font-semibold text-charcoal text-sm leading-tight">{r.name}</span>
            <span class="block mt-0.5 text-xs text-cognac-400 capitalize truncate">{r.baseSpirit}</span>
          </button>
        ))}
      </div>
      <!-- Hidden select — kept so the existing share/state code still functions -->
      <select id="recipe-select" class="sr-only" tabindex="-1" aria-hidden="true">
        <option value="">Select a recipe...</option>
        {recipeTiles.map(r => <option value={r.slug}>{r.name}</option>)}
      </select>
    </div>

    <!-- Bottle Size -->
    <div id="bottle-size-section" class="mb-6">
      <label for="bottle-size" class="block text-sm font-medium text-gray-700 mb-2">
        Bottle Size
      </label>
      <div class="flex flex-col sm:flex-row gap-2">
        <div class="flex gap-2 flex-1" role="radiogroup" aria-label="Bottle size">
          <button type="button" role="radio" aria-checked="false" class="bottle-size-btn flex-1 py-2 px-3 rounded-lg border-2 text-sm font-medium" data-size="375">375ml</button>
          <button type="button" role="radio" aria-checked="true" class="bottle-size-btn flex-1 py-2 px-3 rounded-lg border-2 text-sm font-medium active" data-size="750">750ml</button>
          <button type="button" role="radio" aria-checked="false" class="bottle-size-btn flex-1 py-2 px-3 rounded-lg border-2 text-sm font-medium" data-size="1000">1L</button>
        </div>
        <div class="flex items-center gap-2 sm:w-auto">
          <span class="text-xs text-gray-500 sm:hidden">or custom:</span>
          <input
            type="number"
            id="bottle-size"
            class="w-20 py-2 px-2 border border-study-border bg-study-bg text-cream-100 text-sm text-center focus:border-accent-500 focus:outline-none transition-colors"
            value="750"
            min="100"
            max="3000"
            inputmode="numeric"
            aria-label="Custom bottle size in ml"
          />
          <span class="flex-shrink-0 self-center text-sm font-medium text-gray-600">ml</span>
        </div>
      </div>
    </div>

    <!-- Unit Toggle -->
    <div id="unit-toggle" class="mb-6 flex items-center gap-4">
      <span class="text-sm font-medium text-gray-700" id="display-units-label">Display units:</span>
      <div class="flex rounded-lg border-2 border-gray-200 overflow-hidden" role="radiogroup" aria-labelledby="display-units-label">
        <button type="button" role="radio" aria-checked="true" class="unit-btn px-4 py-2 text-sm font-medium active" data-unit="oz">oz</button>
        <button type="button" role="radio" aria-checked="false" class="unit-btn px-4 py-2 text-sm font-medium" data-unit="ml">ml</button>
      </div>
    </div>

    <!-- Dilution Setting (available in both modes) -->
    {!simple && (
      <div id="dilution-section" class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2" id="dilution-label">
          Dilution (water from ice melt)
        </label>
        <div class="flex gap-2" role="radiogroup" aria-labelledby="dilution-label">
          <button type="button" role="radio" aria-checked="false" class="dilution-btn flex-1 py-2 px-3 rounded-lg border-2 text-sm font-medium" data-dilution="0">
            0% <span class="text-xs text-gray-500">No water</span>
          </button>
          <button type="button" role="radio" aria-checked="true" class="dilution-btn flex-1 py-2 px-3 rounded-lg border-2 text-sm font-medium active" data-dilution="20">
            20% <span class="text-xs text-gray-500">Stirred</span>
          </button>
          <button type="button" role="radio" aria-checked="false" class="dilution-btn flex-1 py-2 px-3 rounded-lg border-2 text-sm font-medium" data-dilution="25">
            25% <span class="text-xs text-gray-500">Shaken</span>
          </button>
        </div>
        <p class="mt-1 text-xs text-gray-500">
          Shaken citrus drinks pick up more water from ice. Spirit-forward stirred drinks need less; freezer batches often need none.
        </p>
      </div>
    )}

    <!-- ============================================ -->
    <!-- PRESET MODE: Batch Instructions (hidden by default) -->
    <!-- ============================================ -->
    <div id="preset-batch-instructions" class="hidden">
      <!-- This gets populated by JavaScript when a preset is selected -->
    </div>

    <!-- ============================================ -->
    <!-- CUSTOM MODE: Ingredient Input Form -->
    <!-- ============================================ -->
    <div id="custom-recipe-form">
      <!-- Live result bar — always visible above the form so the user gets
           immediate feedback while editing without scrolling. -->
      <div id="custom-live-bar" class="mb-5 rounded-xl border-2 border-cognac-200 bg-white px-4 py-3 hidden">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-baseline gap-3">
            <span id="live-abv" class="font-mono font-bold text-2xl text-charcoal">0</span>
            <span class="text-xs uppercase tracking-wider text-cognac-400">% ABV</span>
            <span class="hidden sm:inline-block w-px h-5 bg-cognac-200" aria-hidden="true"></span>
            <span id="live-servings" class="hidden sm:inline-block font-mono font-semibold text-base text-cognac">0</span>
            <span class="hidden sm:inline-block text-xs uppercase tracking-wider text-cognac-400">drinks</span>
          </div>
          <div id="live-status" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide bg-cognac-100 text-cognac">
            <span id="live-status-icon">·</span>
            <span id="live-status-label">Add ingredients</span>
          </div>
        </div>
      </div>

      <fieldset class="mb-6">
        <legend class="block text-sm font-medium text-gray-700 mb-1">Enter the recipe for one drink</legend>
        <p class="text-xs text-gray-500 mb-3">
          Type the ingredients for a single cocktail and we'll multiply it up to fill a bottle.
          <button type="button" id="load-sample" class="ml-1 text-accent-500 hover:text-accent-600 underline-offset-2 hover:underline font-medium">
            Try a sample &rarr;
          </button>
        </p>
        <!-- Column Headers -->
        <div class="grid grid-cols-12 gap-2 mb-2 text-xs text-gray-500 font-medium">
          <span class="col-span-5">Ingredient</span>
          <span class="col-span-3 text-center">
            Amount (<span id="amount-unit-label">oz</span>)
          </span>
          <span class="col-span-3 text-center" title="Alcohol By Volume — typical spirits are 40%, vermouth ~16%, juice 0%">
            ABV %
          </span>
          <span class="col-span-1"></span>
        </div>
        <div id="ingredients-container" class="space-y-3">
          <!-- Ingredient rows added dynamically -->
        </div>
        <div class="mt-3 flex items-center justify-between gap-3 flex-wrap">
          <button
            type="button"
            id="add-ingredient"
            class="inline-flex items-center gap-1 text-primary hover:text-primary-600 font-medium text-sm disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Ingredient
          </button>
          <details class="abv-help group text-xs relative">
            <summary class="cursor-pointer text-cognac-400 hover:text-cognac-600 select-none inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 16v-4M12 8h.01" stroke-linecap="round"/>
              </svg>
              ABV cheatsheet
            </summary>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-cognac-500 bg-white rounded-lg p-3 absolute right-0 top-6 w-64 shadow-lg border border-cognac-200 z-20">
              <span>Vodka, gin, rum, tequila</span><span class="text-right font-mono text-charcoal">40%</span>
              <span>Bourbon, rye whiskey</span><span class="text-right font-mono text-charcoal">45%</span>
              <span>Sweet vermouth</span><span class="text-right font-mono text-charcoal">16%</span>
              <span>Dry vermouth</span><span class="text-right font-mono text-charcoal">18%</span>
              <span>Campari</span><span class="text-right font-mono text-charcoal">25%</span>
              <span>Aperol</span><span class="text-right font-mono text-charcoal">11%</span>
              <span>Cointreau, triple sec</span><span class="text-right font-mono text-charcoal">40%</span>
              <span>Kahlúa</span><span class="text-right font-mono text-charcoal">20%</span>
              <span>Juice, syrup, water</span><span class="text-right font-mono text-charcoal">0%</span>
            </div>
          </details>
        </div>
      </fieldset>

      <!-- Results Panel (custom mode) -->
      <div id="results-panel" class="mt-8 p-6 rounded-xl bg-gray-50 border-2 border-gray-200">
        <h2 class="text-lg font-semibold text-charcoal mb-4">Your Batch</h2>

        <!-- Main Stats -->
        <div class="grid grid-cols-3 gap-4 mb-6">
          <div class="text-center">
            <span id="final-abv" class="block text-3xl font-bold font-mono text-charcoal">0</span>
            <span class="text-sm text-gray-500">Final ABV %</span>
          </div>
          <div class="text-center">
            <span id="total-volume" class="block text-3xl font-bold font-mono text-charcoal">0</span>
            <span id="volume-unit" class="text-sm text-gray-500">oz</span>
          </div>
          <div class="text-center">
            <span id="servings" class="block text-3xl font-bold font-mono text-charcoal">0</span>
            <span class="text-sm text-gray-500">Drinks</span>
          </div>
        </div>

        <!-- Freeze Status -->
        <div id="freeze-status" class="p-4 rounded-lg border-2 mb-6 status-empty">
          <div class="flex items-center gap-2">
            <span id="status-icon" class="text-2xl">·</span>
            <div>
              <span id="status-label" class="font-semibold">Waiting for ingredients</span>
              <p id="status-message" class="text-sm opacity-80">Aim for around 22% ABV or higher to keep the batch pourable in the freezer.</p>
            </div>
          </div>
        </div>

        <!-- Recipe Output -->
        <div id="recipe-output" class="space-y-3">
          <div class="py-2 border-b border-gray-200">
            <div class="flex justify-between items-center">
              <span class="font-medium">Pour off from bottle:</span>
              <span id="pour-off" class="font-mono font-semibold">0 oz</span>
            </div>
            <p class="text-xs text-gray-500 mt-1">Remove this much spirit to make room. Save it for later.</p>
          </div>
          <div id="ingredients-output" class="space-y-2">
            <!-- Filled dynamically -->
          </div>
          <div class="flex justify-between items-center py-2 border-t border-gray-200">
            <span class="font-medium">Water to add:</span>
            <span id="water-add" class="font-mono font-semibold">0 oz</span>
          </div>
        </div>

        <!-- Composition bar — visual breakdown of what's in the bottle. -->
        <div id="composition-bar" class="mt-6 hidden"></div>

        <!-- Actions — instant in-place actions, no mid-flow modal interruption -->
        <div class="flex flex-col sm:flex-row gap-3 mt-6">
          <button type="button" id="copy-btn" class="btn-primary flex-1 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            Copy recipe
          </button>
          <button type="button" id="share-btn" class="btn-secondary flex-1 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            Share link
          </button>
          <button type="button" id="print-btn" class="btn-ghost flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Print
          </button>
        </div>

        <!-- Email recipe — inline form, no modal interruption. -->
        <form id="email-recipe-form" class="email-recipe-row mt-5 pt-5 border-t border-cognac-200/60">
          <div class="flex flex-col sm:flex-row gap-2 items-stretch">
            <input
              type="email"
              name="email"
              required
              placeholder="your@email.com"
              autocomplete="email"
              class="flex-1 px-4 py-2.5 border border-cognac-200 rounded-lg text-sm bg-white
                     focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 focus:outline-none transition-all"
              aria-label="Your email"
            />
            <button type="submit" class="email-send-btn btn-secondary text-sm whitespace-nowrap inline-flex items-center justify-center gap-2 px-4">
              <svg class="email-send-icon w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <svg class="email-send-spinner w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
              </svg>
              <span class="email-send-label">Email me this</span>
            </button>
          </div>
          <label class="flex items-center gap-2 mt-2.5 text-xs text-cognac-500 cursor-pointer select-none">
            <input type="checkbox" name="subscribe" class="w-3.5 h-3.5 text-accent-500 border-cognac-300 rounded focus:ring-accent-500" />
            <span>Also send me Cold Open — one make-ahead recipe and a hosting timeline, monthly.</span>
          </label>
          <label class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            Leave this field empty
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="turnstile-container mt-3" aria-label="Verification challenge"></div>
          <p class="turnstile-note mt-2 text-xs text-cognac-500" aria-live="polite"></p>
          <p class="email-status hidden mt-2 text-xs" role="status" aria-live="polite" tabindex="-1"></p>
        </form>
      </div>
    </div>
  </div>
</batch-calculator>

<!-- Ingredient Row Template -->
<template id="ingredient-row-template">
  <div class="ingredient-row group relative bg-white/60 border border-cognac-200 rounded-xl p-3 mb-2 transition-all duration-200 hover:border-cognac-300 hover:shadow-sm animate-row-in">
    <div class="grid grid-cols-12 gap-2 items-center">
      <input
        type="text"
        placeholder="Ingredient name"
        class="col-span-5 input-field py-2 text-sm border-0 bg-white/80"
        name="name"
        maxlength="60"
        autocomplete="off"
        list="ingredient-suggestions"
      />
      <input
        type="number"
        placeholder="2"
        class="col-span-3 input-field py-2 text-sm text-center border-0 bg-white/80"
        name="amount"
        min="0.01"
        max="100"
        step="0.25"
        inputmode="decimal"
      />
      <input
        type="number"
        placeholder="40"
        class="col-span-3 input-field py-2 text-sm text-center border-0 bg-white/80"
        name="abv"
        min="0"
        max="100"
        step="0.5"
        inputmode="decimal"
      />
      <button
        type="button"
        class="col-span-1 p-2 text-cognac-300 hover:text-danger opacity-50 hover:opacity-100 focus:opacity-100 transition-all remove-ingredient"
        aria-label="Remove ingredient"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</template>

<!-- Ingredient Suggestions Datalist -->
<datalist id="ingredient-suggestions">
  <option value="Vodka">
  <option value="Gin">
  <option value="Bourbon">
  <option value="Rye Whiskey">
  <option value="Tequila">
  <option value="White Rum">
  <option value="Dark Rum">
  <option value="Triple Sec">
  <option value="Cointreau">
  <option value="Campari">
  <option value="Sweet Vermouth">
  <option value="Dry Vermouth">
  <option value="Kahlua">
  <option value="Lime Juice">
  <option value="Lemon Juice">
  <option value="Simple Syrup">
  <option value="Orange Juice">
  <option value="Cranberry Juice">
  <option value="Olive Brine">
</datalist>

<style is:global>
  /* Batch step styles — global because the trusted preset template is injected
     via innerHTML, so Astro's scoped class hashes would not match. The Study treatment:
     italic Cormorant step numerals on dark, brass accents. */
  .batch-step {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid #2e2720;
  }
  .batch-step:last-child {
    border-bottom: 0;
  }
  .batch-step-number {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.625rem;
    font-style: italic;
    font-weight: 400;
    color: #c8a55c;
  }
  .batch-step-content {
    flex: 1;
  }
  .batch-step h4 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    font-size: 1.15rem;
    color: #f0e8da;
    margin-bottom: 0.35rem;
    letter-spacing: -0.005em;
  }
  .batch-step p {
    font-size: 0.875rem;
    color: #b5a99a;
    line-height: 1.6;
    font-weight: 300;
  }
  .batch-ingredient-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.4rem 0;
    border-bottom: 1px solid #2e2720;
  }
  .batch-ingredient-item:last-child {
    border-bottom: 0;
  }
  .batch-ingredient-item span:first-child {
    color: #b5a99a;
    font-size: 0.9rem;
    font-weight: 300;
  }
  .batch-ingredient-item span:last-child {
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: #f0e8da;
    font-size: 1.25rem;
    font-weight: 400;
  }
</style>

<style>
  /* Mode toggle — dark container, brass-tinted indicator slides */
  .mode-toggle-container {
    border: 1px solid #2e2720;
    background: #0c0a08;
  }

  .mode-toggle-indicator {
    background: rgba(200, 165, 92, 0.15);
    border: 1px solid rgba(200, 165, 92, 0.4);
    box-shadow: 0 0 20px rgba(200, 165, 92, 0.1);
  }

  .entry-mode-btn {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 12px;
    font-weight: 500;
  }

  .entry-mode-btn[aria-pressed="true"] {
    color: #c8a55c;
    background: transparent;
  }
  .entry-mode-btn[aria-pressed="false"] {
    color: #9a8e7e;
    background: transparent;
  }
  .entry-mode-btn[aria-pressed="false"]:hover {
    color: #e8e0d4;
  }

  .mode-toggle-container:has(.entry-mode-btn[data-mode="custom"][aria-pressed="true"]) .mode-toggle-indicator {
    left: calc(50% + 3px);
  }

  /* Recipe tile selection state — brass border + tint */
  .recipe-tile {
    background: #0c0a08;
    border: 1px solid #2e2720;
    transition: all 0.2s ease;
  }
  .recipe-tile:hover {
    border-color: #3d3428;
    background: #161310;
  }
  .recipe-tile-active {
    background: rgba(200, 165, 92, 0.1) !important;
    border-color: #c8a55c !important;
    box-shadow: 0 0 0 1px rgba(200, 165, 92, 0.3);
  }
  .recipe-tile span:first-child {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.05rem;
    color: #f0e8da;
  }
  .recipe-tile span:last-child {
    color: #9a8e7e;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  /* ABV cheatsheet disclosure */
  .abv-help summary {
    list-style: none;
  }
  .abv-help summary::-webkit-details-marker { display: none; }
  .abv-help summary::marker { content: ''; }

  /* Toggle button rows: bottle-size, unit, dilution */
  .bottle-size-btn,
  .unit-btn,
  .dilution-btn {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.2s ease;
  }

  .bottle-size-btn.active,
  .unit-btn.active,
  .dilution-btn.active {
    border-color: #c8a55c !important;
    background: rgba(200, 165, 92, 0.12);
    color: #c8a55c;
  }

  .bottle-size-btn:not(.active),
  .unit-btn:not(.active),
  .dilution-btn:not(.active) {
    border-color: #2e2720;
    background: transparent;
    color: #9a8e7e;
  }
  .bottle-size-btn:not(.active):hover,
  .unit-btn:not(.active):hover,
  .dilution-btn:not(.active):hover {
    border-color: #3d3428;
    color: #e8e0d4;
  }
</style>

<script>
  import {
    calculateBatchFromBottle,
    calculateMilkStreetBatch,
    mlToOz,
    ozToMl,
    suggestABV,
    STANDARD_BOTTLE_ML,
    MILK_STREET_BATCHES,
    type RecipeIngredient,
    type BatchResult
  } from '../lib/calculator';
  import {
    buildShareUrl,
    parseLegacyShareState,
    parseShareState,
    type ShareStateV1
  } from '../lib/shareState';
  import { abvBand, pageType, track } from '../lib/analytics';

  class BatchCalculator extends HTMLElement {
    private unit: 'oz' | 'ml' = 'oz';
    private bottleSizeMl: number = STANDARD_BOTTLE_ML;
    // Default to preset — most visitors want a known recipe, not a blank form.
    private mode: 'custom' | 'preset' = 'preset';
    private currentPresetId: string | null = null;
    private dilutionPercent: number = 20;
    private isHydrating = false;
    private emailRequestIds = new WeakMap<HTMLFormElement, string>();
    private emailTurnstileWidgets = new WeakMap<HTMLFormElement, string | number>();
    // Analytics only. `calculator_started` fires once per page load;
    // `result_completed` fires once per distinct trigger+mode+recipe+bottle
    // combination.
    private startedTracked = false;
    private trackedResultKeys = new Set<string>();
    // `result_completed` provenance. `hasInteracted` is deliberately broader than
    // `startedTracked`: any real input counts, so a result is never mislabelled
    // `auto`. `nextResultTrigger` is a one-shot override for the hydration path.
    private hasInteracted = false;
    private nextResultTrigger: 'shared_link' | null = null;

    connectedCallback() {
      this.setupEventListeners();

      const searchParams = new URLSearchParams(window.location.search);
      const batchValue = searchParams.get('batch');
      const hasLegacyState = searchParams.has('recipe') || searchParams.has('ingredients');
      const hasUrlState = batchValue !== null || hasLegacyState;
      const parsedState = batchValue !== null
        ? parseShareState(batchValue)
        : hasLegacyState
          ? parseLegacyShareState(searchParams)
          : null;

      // Keep the normal blank custom form ready when a preset is active. Custom
      // hydration replaces these rows with the validated shared ingredients.
      this.addIngredientRow();
      this.addIngredientRow();

      if (hasUrlState) {
        this.trackSharedLinkOpened(batchValue !== null ? 'batch-v1' : 'legacy', parsedState?.ok === true, parsedState?.ok ? parsedState.state.mode : null);
      }

      if (parsedState?.ok) {
        this.hydrateSharedState(parsedState.state);
        this.showShareStateStatus('Shared recipe loaded');
        return;
      }

      this.initializeDefaults();

      if (hasUrlState) {
        this.showShareStateStatus("Couldn't load the shared recipe — showing defaults", true);
      }
    }

    private trackSharedLinkOpened(format: 'batch-v1' | 'legacy', valid: boolean, mode: 'custom' | 'preset' | null) {
      track('shared_link_opened', { mode: mode ?? 'unknown', format, valid });
    }

    /**
     * First meaningful interaction with the calculator, once per page load.
     * Hydrating a shared link is not an interaction, so it is excluded.
     */
    private trackCalculatorStarted() {
      if (this.startedTracked || this.isHydrating) return;
      this.startedTracked = true;
      track('calculator_started', { mode: this.mode, page_type: pageType(window.location.pathname) });
    }

    /**
     * Interaction provenance for `result_completed` only. Kept separate from
     * `trackCalculatorStarted` so that event's shipped definition is unchanged.
     */
    private markInteracted() {
      if (this.isHydrating) return;
      this.hasInteracted = true;
    }

    /**
     * A valid calculation rendered. Debounced to one event per distinct
     * trigger+mode+recipe+bottle combination per page load, so live typing in
     * custom mode does not produce a stream of events.
     */
    private trackResultCompleted(result: { finalAbv: number; freezeStatus: string }) {
      if (this.isHydrating) return;
      const trigger = this.nextResultTrigger ?? (this.hasInteracted ? 'user' : 'auto');
      this.nextResultTrigger = null;
      const recipe = this.mode === 'preset' ? (this.currentPresetId ?? 'unknown') : 'custom';
      // `trigger` is part of the debounce key on purpose: a recipe page fires `auto`
      // on load, and the visitor's first real interaction on that same combination
      // must still produce a `user` event or the activation funnel reads as empty.
      const key = `${trigger}|${this.mode}|${recipe}|${this.bottleSizeMl}`;
      if (this.trackedResultKeys.has(key)) return;
      this.trackedResultKeys.add(key);
      track('result_completed', {
        trigger,
        mode: this.mode,
        recipe,
        bottle_ml: this.bottleSizeMl,
        freezer_safe: result.freezeStatus === 'safe',
        abv_band: abvBand(result.finalAbv),
      });
    }

    private initializeDefaults() {
      // Default to preset mode (visible state matches mode field).
      this.setMode(this.mode);

      // A recipe page supplies its normal preset through the data attribute.
      const presetSlug = this.dataset.cocktail;
      if (presetSlug && MILK_STREET_BATCHES[presetSlug]) {
        const select = this.querySelector('#recipe-select') as HTMLSelectElement;
        if (select) select.value = presetSlug;
        this.loadPreset(presetSlug);
      } else {
        this.recalculate();
      }
    }

    private hydrateSharedState(state: ShareStateV1) {
      this.isHydrating = true;

      if (state.mode === 'preset') {
        this.setMode('preset');
        this.setBottleSize(state.bottleMl);
        this.setUnit(state.unit);

        const select = this.querySelector('#recipe-select') as HTMLSelectElement | null;
        if (select) select.value = state.recipe;
        this.markActiveTile(state.recipe);

        this.nextResultTrigger = 'shared_link';
        this.isHydrating = false;
        this.loadPreset(state.recipe);
        return;
      }

      this.setMode('custom');
      const container = this.querySelector('#ingredients-container');
      container?.replaceChildren();
      state.ingredients.forEach((ingredient) => {
        this.addIngredientRow({
          name: ingredient.name,
          amount: String(ingredient.amount),
          abv: String(ingredient.abv),
          isBaseSpirit: ingredient.isBaseSpirit
        });
      });
      this.setBottleSize(state.bottleMl);
      this.setUnit(state.unit);
      this.setDilution(state.dilutionPercent);

      this.nextResultTrigger = 'shared_link';
      this.isHydrating = false;
      this.recalculate();
    }

    private showShareStateStatus(message: string, isError = false) {
      const status = this.querySelector('#share-state-status');
      if (!status) return;

      status.textContent = message;
      status.classList.remove('hidden');
      status.classList.toggle('border-danger/30', isError);
      status.classList.toggle('text-danger', isError);
    }

    private setupEventListeners() {
      // First meaningful interaction: any focus inside the calculator counts,
      // alongside the explicit mode/recipe handlers below.
      // Capture phase so the interaction flag is set before any specific handler
      // below runs, independent of listener registration order.
      (['pointerdown', 'keydown', 'change'] as const).forEach((type) => {
        this.addEventListener(type, () => this.markInteracted(), { capture: true });
      });
      this.addEventListener('focusin', () => {
        this.markInteracted();
        this.trackCalculatorStarted();
      });

      // Mode toggle
      this.querySelectorAll('.entry-mode-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const mode = target.dataset.mode as 'custom' | 'preset';
          this.setMode(mode);
          this.trackCalculatorStarted();
        });
      });

      // Recipe selector (legacy hidden <select>, preserved for share-link state)
      this.querySelector('#recipe-select')?.addEventListener('change', (e) => {
        const select = e.target as HTMLSelectElement;
        if (select.value) {
          this.trackCalculatorStarted();
          this.loadPreset(select.value);
          track('recipe_selected', { recipe: select.value });
        } else {
          this.clearPreset();
        }
      });

      // Recipe tile click — visual picker
      this.querySelectorAll('.recipe-tile').forEach(tile => {
        tile.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const slug = target.dataset.recipe;
          if (!slug) return;
          // Sync hidden select for state/share consistency
          const select = this.querySelector('#recipe-select') as HTMLSelectElement | null;
          if (select) select.value = slug;
          this.trackCalculatorStarted();
          this.loadPreset(slug);
          track('recipe_selected', { recipe: slug });
        });
      });

      // Bottle size buttons
      this.querySelectorAll('.bottle-size-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          this.setBottleSize(parseInt(target.dataset.size || '750'));
        });
      });

      // Bottle size input
      this.querySelector('#bottle-size')?.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement;
        this.setBottleSize(parseInt(input.value) || STANDARD_BOTTLE_ML);
      });

      // Unit toggle
      this.querySelectorAll('.unit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          this.setUnit(target.dataset.unit as 'oz' | 'ml');
        });
      });

      // Dilution buttons
      this.querySelectorAll('.dilution-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          this.setDilution(parseInt(target.dataset.dilution || '22'));
        });
      });

      // Add ingredient
      this.querySelector('#add-ingredient')?.addEventListener('click', () => {
        this.addIngredientRow();
      });

      // "Try a sample" — load a Negroni-shaped 1:1:1 example so first-time
      // users can see how the form maps to a working batch.
      this.querySelector('#load-sample')?.addEventListener('click', () => {
        this.loadSampleRecipe();
      });

      // Ingredient inputs (delegated)
      this.querySelector('#ingredients-container')?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.name === 'name') {
          const suggested = suggestABV(target.value);
          if (suggested !== null) {
            const row = target.closest('.ingredient-row');
            const abvInput = row?.querySelector('[name="abv"]') as HTMLInputElement;
            if (abvInput && !abvInput.value) {
              abvInput.value = String(suggested);
            }
          }
        }
        this.recalculate();
      });

      // Remove ingredient (delegated)
      this.querySelector('#ingredients-container')?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const removeBtn = target.closest('.remove-ingredient');
        if (removeBtn) {
          const row = removeBtn.closest('.ingredient-row');
          row?.remove();
          this.updateAddIngredientState();
          this.recalculate();
        }
      });

      // Share button
      this.querySelector('#share-btn')?.addEventListener('click', () => {
        this.shareRecipe();
      });

      // Print button
      this.querySelector('#print-btn')?.addEventListener('click', () => {
        window.print();
      });

      // Copy recipe — assembles a clean text version and writes it to clipboard
      this.querySelector('#copy-btn')?.addEventListener('click', () => {
        this.copyRecipe();
      });

      // Inline email form (custom mode). The preset-mode form is wired up
      // when its HTML is rendered by loadPreset().
      const emailForm = this.querySelector('#email-recipe-form') as HTMLFormElement | null;
      if (emailForm) this.setupEmailForm(emailForm);
    }

    private setMode(mode: 'custom' | 'preset') {
      this.mode = mode;

      // Update button states
      this.querySelectorAll('.entry-mode-btn').forEach(btn => {
        const btnMode = (btn as HTMLButtonElement).dataset.mode;
        btn.setAttribute('aria-pressed', String(btnMode === mode));
      });

      // Show/hide sections based on mode
      const presetSelector = this.querySelector('#preset-selector');
      const customForm = this.querySelector('#custom-recipe-form');
      const presetInstructions = this.querySelector('#preset-batch-instructions');
      const dilutionSection = this.querySelector('#dilution-section');

      if (mode === 'preset') {
        presetSelector?.classList.remove('hidden');
        customForm?.classList.add('hidden');
        // Dilution doesn't apply in preset mode — Milk Street recipes have fixed water amounts
        dilutionSection?.classList.add('hidden');
        // Show instructions if a preset is already selected
        if (this.currentPresetId) {
          presetInstructions?.classList.remove('hidden');
        }
      } else {
        presetSelector?.classList.add('hidden');
        presetInstructions?.classList.add('hidden');
        customForm?.classList.remove('hidden');
        dilutionSection?.classList.remove('hidden');
        this.currentPresetId = null;
        if (!this.isHydrating) this.recalculate();
      }
    }

    private setBottleSize(sizeMl: number) {
      // C2 guard: input attributes are UX hints, so reject invalid values again
      // before they can reach calculations or trusted preset-template rendering.
      if (!Number.isInteger(sizeMl) || sizeMl < 100 || sizeMl > 3000) return;
      this.bottleSizeMl = sizeMl;

      // Update button states + aria-checked for screen readers
      this.querySelectorAll('.bottle-size-btn').forEach(btn => {
        const btnSize = parseInt((btn as HTMLButtonElement).dataset.size || '0');
        const active = btnSize === sizeMl;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-checked', String(active));
      });

      // Update input
      const input = this.querySelector('#bottle-size') as HTMLInputElement;
      if (input) input.value = String(sizeMl);

      // Refresh display
      if (this.isHydrating) return;
      if (this.currentPresetId) {
        this.loadPreset(this.currentPresetId);
      } else {
        this.recalculate();
      }
    }

    private setUnit(unit: 'oz' | 'ml') {
      this.unit = unit;

      // Update button states + aria-checked for screen readers
      this.querySelectorAll('.unit-btn').forEach(btn => {
        const btnUnit = (btn as HTMLButtonElement).dataset.unit;
        const active = btnUnit === unit;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-checked', String(active));
      });

      // Update display label and the Amount column header
      const volumeUnit = this.querySelector('#volume-unit');
      if (volumeUnit) volumeUnit.textContent = unit;
      const amountUnitLabel = this.querySelector('#amount-unit-label');
      if (amountUnitLabel) amountUnitLabel.textContent = unit;

      // Refresh display
      if (this.isHydrating) return;
      if (this.currentPresetId) {
        this.loadPreset(this.currentPresetId);
      } else {
        this.recalculate();
      }
    }

    private setDilution(percent: number) {
      if (!Number.isFinite(percent) || percent < 0 || percent > 35) return;
      this.dilutionPercent = percent;

      // Update button states + aria-checked for screen readers
      this.querySelectorAll('.dilution-btn').forEach(btn => {
        const btnDilution = parseInt((btn as HTMLButtonElement).dataset.dilution || '0');
        const active = btnDilution === percent;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-checked', String(active));
      });

      // Refresh display based on mode
      if (this.isHydrating) return;
      if (this.currentPresetId) {
        this.loadPreset(this.currentPresetId);
      } else {
        this.recalculate();
      }
    }

    private addIngredientRow(values?: {
      name: string;
      amount: string;
      abv: string;
      isBaseSpirit?: boolean;
    }) {
      const template = document.querySelector('#ingredient-row-template') as HTMLTemplateElement;
      const container = this.querySelector('#ingredients-container');

      if (template && container) {
        if (container.querySelectorAll('.ingredient-row').length >= 8) {
          this.updateAddIngredientState();
          return;
        }

        const clone = template.content.cloneNode(true) as DocumentFragment;
        if (values) {
          const row = clone.querySelector('.ingredient-row');
          if (row) {
            (row.querySelector('[name="name"]') as HTMLInputElement).value = values.name;
            (row.querySelector('[name="amount"]') as HTMLInputElement).value = values.amount;
            (row.querySelector('[name="abv"]') as HTMLInputElement).value = values.abv;
            if (typeof values.isBaseSpirit === 'boolean') {
              (row as HTMLElement).dataset.baseSpirit = String(values.isBaseSpirit);
            }
          }
        }
        container.appendChild(clone);
        this.updateAddIngredientState();
      }
    }

    private updateAddIngredientState() {
      const addButton = this.querySelector('#add-ingredient') as HTMLButtonElement | null;
      if (!addButton) return;

      const atLimit = this.querySelectorAll('#ingredients-container .ingredient-row').length >= 8;
      addButton.disabled = atLimit;
      addButton.setAttribute('aria-disabled', String(atLimit));
      addButton.title = atLimit ? 'Maximum of 8 ingredients' : '';
    }

    private loadSampleRecipe() {
      const container = this.querySelector('#ingredients-container');
      if (!container) return;
      container.replaceChildren();
      // Classic 1:1:1 Negroni — a forgiving 28% ABV batch
      this.addIngredientRow({ name: 'Gin', amount: '1', abv: '40' });
      this.addIngredientRow({ name: 'Campari', amount: '1', abv: '25' });
      this.addIngredientRow({ name: 'Sweet Vermouth', amount: '1', abv: '16' });
      this.recalculate();
    }

    private clearPreset() {
      this.currentPresetId = null;
      const presetInstructions = this.querySelector('#preset-batch-instructions');
      presetInstructions?.classList.add('hidden');
      if (presetInstructions) presetInstructions.replaceChildren();
      this.markActiveTile(null);
    }

    private markActiveTile(slug: string | null) {
      this.querySelectorAll('.recipe-tile').forEach(tile => {
        const t = tile as HTMLButtonElement;
        const isActive = t.dataset.recipe === slug;
        t.classList.toggle('recipe-tile-active', isActive);
        t.setAttribute('aria-checked', String(isActive));
      });
    }

    private loadPreset(presetId: string) {
      const recipe = MILK_STREET_BATCHES[presetId];
      if (!recipe) return;

      this.currentPresetId = presetId;

      // Calculate the batch
      const result = calculateMilkStreetBatch(presetId, this.bottleSizeMl);
      if (!result) return;

      // Build the batch instructions HTML
      const presetInstructions = this.querySelector('#preset-batch-instructions');
      if (!presetInstructions) return;

      // Format helpers - use pre-rounded oz values directly, don't convert from ml
      const formatOz = (oz: number) => `${oz} oz`;
      const formatMl = (ml: number) => `${Math.round(ml)} ml`;

      // Build ingredients list HTML - use the already-rounded amountOz values
      let ingredientsHtml = '';
      result.ingredientsToAdd.forEach(ing => {
        const display = this.unit === 'oz' ? formatOz(ing.amountOz) : formatMl(ing.amountMl);
        ingredientsHtml += `
          <div class="batch-ingredient-item">
            <span class="text-gray-700">${ing.name}</span>
            <span class="font-mono font-semibold">${display}</span>
          </div>
        `;
      });

      // Add water if needed - use pre-rounded waterToAddOz
      if (result.waterToAddMl > 0) {
        const waterDisplay = this.unit === 'oz' ? formatOz(result.waterToAddOz) : formatMl(result.waterToAddMl);
        ingredientsHtml += `
          <div class="batch-ingredient-item">
            <span class="text-gray-700">Water</span>
            <span class="font-mono font-semibold">${waterDisplay}</span>
          </div>
        `;
      }

      // Add extras note if present
      const extrasNote = recipe.extras ? `<p class="text-xs text-gray-500 mt-2 italic">Also add: ${recipe.extras}</p>` : '';

      // Composition bar — visual breakdown of the bottle's makeup
      const compositionParts = [
        { name: recipe.baseSpirit, ml: result.baseSpiritInBottleMl, abv: recipe.baseSpiritAbv },
        ...result.ingredientsToAdd.map(i => ({ name: i.name, ml: i.amountMl, abv: i.abv })),
        ...(result.waterToAddMl > 0 ? [{ name: 'Water', ml: result.waterToAddMl, abv: 0 }] : []),
      ];
      // Freeze status styling
      const statusClass = result.freezeStatus === 'safe' ? 'status-safe' : result.freezeStatus === 'slushy' ? 'status-slushy' : 'status-freeze';
      const statusIcon = result.freezeStatus === 'safe' ? '✓' : result.freezeStatus === 'slushy' ? '⚠' : '✗';
      const statusLabel = result.freezeStatus === 'safe' ? 'Perfect for Freezer' : result.freezeStatus === 'slushy' ? 'Will Be Slushy' : 'May Freeze Solid';

      presetInstructions.innerHTML = `
        <div style="background: #161310; border: 1px solid #2e2720; padding: 2rem;">
          <p style="font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #c8a55c; font-weight: 500; margin: 0 0 0.75rem;">Your Batch</p>
          <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2rem; font-style: italic; font-weight: 400; color: #f0e8da; margin: 0 0 0.5rem; line-height: 1.1;">${this.getRecipeName(presetId)}</h3>
          <p style="color: #9a8e7e; font-size: 14px; margin: 0 0 2rem; font-weight: 300;">Follow these steps for a ${this.bottleSizeMl}ml batch</p>

          <!-- Stats Row -->
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; margin-bottom: 2rem; padding: 1.5rem 0; border-top: 1px solid #2e2720; border-bottom: 1px solid #2e2720;">
            <div style="text-align: center; border-right: 1px solid #2e2720;">
              <span style="display: block; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.25rem; font-weight: 400; color: #c8a55c; line-height: 1;">${result.finalAbv.toFixed(1)}<span style="font-size: 1.25rem;">%</span></span>
              <span style="display: block; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #9a8e7e; margin-top: 0.5rem; font-weight: 500;">ABV</span>
            </div>
            <div style="text-align: center; border-right: 1px solid #2e2720;">
