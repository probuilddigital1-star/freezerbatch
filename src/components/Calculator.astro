          <!-- Inline email recipe form (no modal) -->
          <form class="email-recipe-row preset-email-form mt-5 pt-5 border-t border-study-border">
            <div class="flex flex-col sm:flex-row gap-2 items-stretch">
              <input type="email" name="email" required placeholder="your@email.com" autocomplete="email"
                class="flex-1 px-4 py-2.5 border border-cognac-200 rounded-lg text-sm bg-white focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20 focus:outline-none transition-all"
