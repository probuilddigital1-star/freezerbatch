              <button type="submit" class="email-send-btn btn-secondary text-sm whitespace-nowrap inline-flex items-center justify-center gap-2 px-4">
                <svg class="email-send-icon w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <svg class="email-send-spinner w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
                <span class="email-send-label">Email me this</span>
              </button>
            </div>
          <label class="flex items-center gap-2 mt-2.5 text-xs text-cognac-500 cursor-pointer select-none">
            <input type="checkbox" name="subscribe" class="w-3.5 h-3.5 text-accent-500 border-cognac-300 rounded focus:ring-accent-500" />
            <span>Also send me Cold Open — one make-ahead recipe and a hosting timeline, monthly.</span>
          </label>
          <label class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
            Leave this field empty
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="turnstile-container mt-3" aria-label="Verification challenge"></div>
          <p class="turnstile-note mt-2 text-xs text-cognac-500" aria-live="polite"></p>
          <p class="email-status hidden mt-2 text-xs" role="status" aria-live="polite" tabindex="-1"></p>
          </form>
        </div>
      `;

      // The preset shell above contains only trusted, authored recipe data. Build the
      // composition separately with DOM APIs so this renderer is also safe for custom data.
      const presetComposition = presetInstructions.querySelector('.preset-composition');
      presetComposition?.replaceChildren(this.renderCompositionBar(compositionParts));

      // Add event listeners for the new buttons
      presetInstructions.querySelector('.preset-copy-btn')?.addEventListener('click', () => {
        this.copyRecipe();
      });
      presetInstructions.querySelector('.preset-share-btn')?.addEventListener('click', () => {
        this.shareRecipe();
      });
      presetInstructions.querySelector('.preset-print-btn')?.addEventListener('click', () => {
        window.print();
      });
      // Inline email form
      const presetEmailForm = presetInstructions.querySelector('.preset-email-form') as HTMLFormElement | null;
      if (presetEmailForm) this.setupEmailForm(presetEmailForm);

      // Show the instructions panel
      presetInstructions.classList.remove('hidden');

      // Mark the active tile
      this.markActiveTile(presetId);

      // Also update the hidden results panel elements for test compatibility
      this.syncResultsPanel(result);
      this.trackResultCompleted(result);
    }

    private syncResultsPanel(result: any) {
      const formatVolume = (ml: number) => {
        return this.unit === 'oz'
          ? `${mlToOz(ml)} oz`
          : `${Math.round(ml)} ml`;
      };

      // Update main stats
      const abvEl = this.querySelector('#final-abv');
      const volumeEl = this.querySelector('#total-volume');
      const servingsEl = this.querySelector('#servings');

      if (abvEl) abvEl.textContent = result.finalAbv.toFixed(1);
      if (volumeEl) volumeEl.textContent = this.unit === 'oz'
        ? mlToOz(this.bottleSizeMl).toFixed(1)
        : String(this.bottleSizeMl);
      if (servingsEl) servingsEl.textContent = String(result.servings);

      // Update freeze status
      const statusEl = this.querySelector('#freeze-status');
      const statusIcon = this.querySelector('#status-icon');
      const statusLabel = this.querySelector('#status-label');
      const statusMessage = this.querySelector('#status-message');

      if (statusEl) {
        statusEl.className = `p-4 rounded-lg border-2 mb-6 status-${result.freezeStatus}`;
      }

      if (statusIcon) {
        statusIcon.textContent = result.freezeStatus === 'safe' ? '✓'
          : result.freezeStatus === 'slushy' ? '⚠' : '✗';
      }

      if (statusLabel) {
        statusLabel.textContent = result.freezeStatus === 'safe' ? 'Safe to Freeze'
          : result.freezeStatus === 'slushy' ? 'Slushy Zone' : 'Will Freeze!';
      }

      if (statusMessage) {
        statusMessage.textContent = result.freezeStatus === 'safe'
          ? 'This will stay perfectly pourable in your freezer'
          : result.freezeStatus === 'slushy'
          ? 'This will get slushy but still be enjoyable'
          : 'The ABV is too low - this will freeze solid';
      }

      // Update pour-off and water
      const pourOffEl = this.querySelector('#pour-off');
      const waterEl = this.querySelector('#water-add');

      if (pourOffEl) {
        pourOffEl.textContent = formatVolume(result.pourOffMl);
      }

      if (waterEl) {
        waterEl.textContent = formatVolume(result.waterToAddMl);
      }

      // Update ingredients output for test compatibility
      const ingredientsOutput = this.querySelector('#ingredients-output');
      if (ingredientsOutput && result.ingredientsToAdd) {
        ingredientsOutput.replaceChildren();
        result.ingredientsToAdd.forEach((ing: any) => {
          const row = document.createElement('div');
          row.className = 'flex justify-between items-center py-1 text-sm';
          const nameSpan = document.createElement('span');
          nameSpan.className = 'text-gray-600';
          nameSpan.textContent = ing.name;
          const amountSpan = document.createElement('span');
          amountSpan.className = 'font-mono';
          amountSpan.textContent = formatVolume(ing.amountMl);
          row.appendChild(nameSpan);
          row.appendChild(amountSpan);
          ingredientsOutput.appendChild(row);
        });
      }
    }

    private getRecipeName(presetId: string): string {
      const names: Record<string, string> = {
        'margarita': 'Margarita',
        'negroni': 'Negroni',
        'manhattan': 'Manhattan',
        'old-fashioned': 'Old Fashioned',
        'daiquiri': 'Daiquiri',
        'dirty-martini': 'Dirty Martini',
        'cosmopolitan': 'Cosmopolitan',
        'espresso-martini': 'Espresso Martini',
        'vesper': 'Vesper',
        'mint-julep': 'Mint Julep',
        'boulevardier': 'Boulevardier',
        'moscow-mule': 'Moscow Mule',
        'paper-plane': 'Paper Plane'
      };
      return names[presetId] || presetId;
    }

    private getRecipeIngredients(): RecipeIngredient[] {
      const rows = Array.from(this.querySelectorAll('.ingredient-row')).slice(0, 8);
      const candidates: Array<{
        name: string;
        amount: number;
        abv: number;
        explicitBaseSpirit: boolean | null;
      }> = [];

      rows.forEach((row) => {
        const nameInput = row.querySelector('[name="name"]') as HTMLInputElement;
        const amountInput = row.querySelector('[name="amount"]') as HTMLInputElement;
        const abvInput = row.querySelector('[name="abv"]') as HTMLInputElement;

        const name = nameInput?.value.trim() || '';
        const amountValue = amountInput?.value.trim() || '';
        const abvValue = abvInput?.value.trim() || '';
        const amount = Number(amountValue);
        const abv = Number(abvValue);
        const nameLength = Array.from(name).length;

        // C2 guard: reject invalid rows instead of trusting maxlength/min/max.
        if (
          nameLength >= 1 &&
          nameLength <= 60 &&
          amountValue !== '' &&
          Number.isFinite(amount) &&
          amount > 0 &&
          amount <= 100 &&
          abvValue !== '' &&
          Number.isFinite(abv) &&
          abv >= 0 &&
          abv <= 100
        ) {
          const baseSpiritValue = (row as HTMLElement).dataset.baseSpirit;
          candidates.push({
            name,
            amount,
            abv,
            explicitBaseSpirit: baseSpiritValue === 'true'
              ? true
              : baseSpiritValue === 'false'
                ? false
                : null
          });
        }
      });

      // A validated shared recipe carries an explicit base-spirit selection.
      // Honor it even when an earlier modifier has a higher ABV. Recipes entered
      // manually have no explicit row metadata and retain the existing heuristic.
      let baseSpiritIndex = candidates.findIndex((ingredient) => ingredient.explicitBaseSpirit === true);
      if (baseSpiritIndex < 0) {
        baseSpiritIndex = candidates.findIndex((ingredient) => ingredient.abv >= 20);
      }
      if (baseSpiritIndex < 0 && candidates.length > 0) {
        baseSpiritIndex = candidates.reduce(
          (maxIndex, ingredient, index) => ingredient.abv > candidates[maxIndex].abv ? index : maxIndex,
          0
        );
      }

      return candidates.map((ingredient, index) => ({
        name: ingredient.name,
        amount: ingredient.amount,
        unit: this.unit,
        abv: ingredient.abv,
        isBaseSpirit: index === baseSpiritIndex
      }));
    }

    private recalculate() {
      // Only recalculate in custom mode
      if (this.mode === 'preset') return;

      const ingredients = this.getRecipeIngredients();

      if (ingredients.length === 0) {
        this.updateDisplayEmpty();
        return;
      }

      const result = calculateBatchFromBottle(
        ingredients,
        this.bottleSizeMl,
        this.dilutionPercent
      );

      this.updateDisplay(result);
      this.trackResultCompleted(result);
    }

    private updateDisplayEmpty() {
      ['#final-abv', '#total-volume', '#servings', '#pour-off', '#water-add'].forEach(sel => {
        const el = this.querySelector(sel);
        if (el) el.textContent = '0';
      });
      const output = this.querySelector('#ingredients-output');
      if (output) output.replaceChildren();

      // Hide the live result bar + composition bar when there's nothing to show
      this.querySelector('#custom-live-bar')?.classList.add('hidden');
      this.querySelector('#composition-bar')?.classList.add('hidden');

      // Reset freeze status to initial neutral state
      const statusEl = this.querySelector('#freeze-status');
      const statusIcon = this.querySelector('#status-icon');
      const statusLabel = this.querySelector('#status-label');
      const statusMessage = this.querySelector('#status-message');

      if (statusEl) statusEl.className = 'p-4 rounded-lg border-2 mb-6 status-empty';
      if (statusIcon) statusIcon.textContent = '·';
      if (statusLabel) statusLabel.textContent = 'Waiting for ingredients';
      if (statusMessage) statusMessage.textContent = 'Aim for around 22% ABV or higher to keep the batch pourable in the freezer.';
    }

    /**
     * Build the visual composition bar — a horizontal stacked bar showing
     * each component's share of the bottle, plus a legend. All names are
     * assigned through textContent/title properties because custom names are
     * user-controlled.
     */
    private renderCompositionBar(parts: Array<{name: string; ml: number; abv: number}>): DocumentFragment {
      const fragment = document.createDocumentFragment();
      const total = parts.reduce((s, p) => s + p.ml, 0);
      if (!Number.isFinite(total) || total <= 0) return fragment;

      // Color by ABV bucket — gives a consistent visual code for "what is this"
      const colorFor = (p: {name: string; abv: number}): string => {
        const n = p.name.toLowerCase();
        if (n.includes('water')) return '#a3c4d4'; // ice blue
        if (p.abv === 0) return '#e6dcd8';          // cream — non-alc mixer/juice
        if (p.abv >= 35) return '#B8860B';          // brass — base spirit
        if (p.abv >= 20) return '#8B0000';          // wine red — Campari/liqueur
        return '#d9a820';                           // amber — vermouth/low-alc
      };

      const heading = document.createElement('p');
      heading.className = 'text-xs uppercase tracking-wider text-cognac-400 mb-2';
      heading.textContent = "What's in the bottle";

      const track = document.createElement('div');
      track.className = 'composition-bar-track flex h-3 rounded-full overflow-hidden border border-cognac-200 bg-white';

      const legend = document.createElement('div');
      legend.className = 'flex flex-wrap gap-x-4 gap-y-1.5 mt-3';

      parts.filter(p => Number.isFinite(p.ml) && p.ml > 0).forEach(p => {
        const pct = (p.ml / total) * 100;
        const color = colorFor(p);

        const segment = document.createElement('div');
        segment.className = 'composition-seg';
        // Tiny segments get min-width so they're still visible.
        segment.style.flex = `0 0 ${Math.max(pct, 2)}%`;
        segment.style.backgroundColor = color;
        segment.title = `${p.name}: ${Math.round(pct)}%`;
        track.appendChild(segment);

        const legendItem = document.createElement('span');
        legendItem.className = 'inline-flex items-center gap-1.5 text-xs text-cognac';

        const swatch = document.createElement('span');
        swatch.className = 'w-2.5 h-2.5 rounded-sm';
        swatch.style.backgroundColor = color;

        const name = document.createElement('span');
        name.className = 'font-medium';
        name.textContent = p.name;

        const percentage = document.createElement('span');
        percentage.className = 'text-cognac-400';
        percentage.textContent = `${Math.round(pct)}%`;

        legendItem.append(swatch, name, percentage);
        legend.appendChild(legendItem);
      });

      fragment.append(heading, track, legend);
      return fragment;
    }

    private updateLiveBar(result: BatchResult) {
      const bar = this.querySelector('#custom-live-bar');
      const abv = this.querySelector('#live-abv');
      const servings = this.querySelector('#live-servings');
      const status = this.querySelector('#live-status');
      const statusIcon = this.querySelector('#live-status-icon');
      const statusLabel = this.querySelector('#live-status-label');

      bar?.classList.remove('hidden');
      if (abv) abv.textContent = result.finalAbv.toFixed(1);
      if (servings) servings.textContent = String(result.servings);

      // Status pill colors mirror the freeze status
      const palette: Record<string, { cls: string; icon: string; label: string }> = {
        safe: { cls: 'bg-success/15 text-success', icon: '✓', label: 'Freezer-safe' },
        slushy: { cls: 'bg-warning/15 text-amber-700', icon: '⚠', label: 'Slushy zone' },
        freeze: { cls: 'bg-danger/15 text-danger', icon: '✗', label: 'Will freeze solid' },
      };
      const p = palette[result.freezeStatus] ?? palette.freeze;
      if (status) {
        status.className = `inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide ${p.cls}`;
      }
      if (statusIcon) statusIcon.textContent = p.icon;
      if (statusLabel) statusLabel.textContent = p.label;
    }

    private updateDisplay(result: BatchResult) {
      // Format helper: prefer pre-rounded oz values (clean quarter-ounce)
      // when available; fall back to ml conversion otherwise.
      const formatOz = (oz: number) => `${oz} oz`;
      const formatMl = (ml: number) => `${Math.round(ml)} ml`;

      // Live summary bar at the top of the form
      this.updateLiveBar(result);

      // Main stats
      const abvEl = this.querySelector('#final-abv');
      const volumeEl = this.querySelector('#total-volume');
      const servingsEl = this.querySelector('#servings');

      if (abvEl) abvEl.textContent = result.finalAbv.toFixed(1);
      if (volumeEl) volumeEl.textContent = this.unit === 'oz'
        ? result.totalVolumeOz.toFixed(1)
        : String(result.totalVolumeMl);
      if (servingsEl) servingsEl.textContent = String(result.servings);

      // Freeze status
      const statusEl = this.querySelector('#freeze-status');
      const statusIcon = this.querySelector('#status-icon');
      const statusLabel = this.querySelector('#status-label');
      const statusMessage = this.querySelector('#status-message');

      if (statusEl) {
        statusEl.className = `p-4 rounded-lg border-2 mb-6 status-${result.freezeStatus}`;
      }

      if (statusIcon) {
        statusIcon.textContent = result.freezeStatus === 'safe' ? '✓'
          : result.freezeStatus === 'slushy' ? '⚠' : '✗';
      }

      if (statusLabel) {
        statusLabel.textContent = result.freezeStatus === 'safe' ? 'Safe to Freeze'
          : result.freezeStatus === 'slushy' ? 'Slushy Zone' : 'Will Freeze!';
      }

      if (statusMessage) {
        statusMessage.textContent = result.freezeMessage;
      }

      // Pour off — use pre-rounded oz value
      const pourOffEl = this.querySelector('#pour-off');
      if (pourOffEl) {
        pourOffEl.textContent = this.unit === 'oz'
          ? formatOz(result.pourOffOz)
          : formatMl(result.pourOffMl);
      }

      // Ingredients to add
      const ingredientsOutput = this.querySelector('#ingredients-output');
      if (ingredientsOutput) {
        ingredientsOutput.replaceChildren();
        result.ingredientsToAdd.forEach(ing => {
          const row = document.createElement('div');
          row.className = 'flex justify-between items-center py-1 text-sm';
          const nameSpan = document.createElement('span');
          nameSpan.className = 'text-gray-600';
          nameSpan.textContent = ing.name;
          const amountSpan = document.createElement('span');
          amountSpan.className = 'font-mono';
          amountSpan.textContent = this.unit === 'oz'
            ? formatOz(ing.amountOz)
            : formatMl(ing.amountMl);
          row.appendChild(nameSpan);
          row.appendChild(amountSpan);
          ingredientsOutput.appendChild(row);
        });
      }

      // Water to add — use pre-rounded oz value
      const waterEl = this.querySelector('#water-add');
      if (waterEl) {
        waterEl.textContent = this.unit === 'oz'
          ? formatOz(result.waterToAddOz)
          : formatMl(result.waterToAddMl);
      }

      // Composition bar — show the bottle's makeup at a glance
      const compEl = this.querySelector('#composition-bar');
      if (compEl) {
        const parts = [
          { name: result.baseSpiritName || 'Base spirit', ml: result.baseSpiritInBottleMl, abv: 40 },
          ...result.ingredientsToAdd.map(i => ({ name: i.name, ml: i.amountMl, abv: i.abv })),
          ...(result.waterToAddMl > 0 ? [{ name: 'Water', ml: result.waterToAddMl, abv: 0 }] : []),
        ];
        compEl.replaceChildren(this.renderCompositionBar(parts));
        compEl.classList.remove('hidden');
      }
    }

    private async shareRecipe() {
      const state: ShareStateV1 = this.mode === 'preset' && this.currentPresetId
        ? {
            v: 1,
            mode: 'preset',
            recipe: this.currentPresetId,
            bottleMl: this.bottleSizeMl,
            unit: this.unit
          }
        : {
            v: 1,
            mode: 'custom',
            bottleMl: this.bottleSizeMl,
            unit: this.unit,
            dilutionPercent: this.dilutionPercent,
            ingredients: this.getRecipeIngredients().map((ingredient) => ({
              name: ingredient.name,
              amount: ingredient.amount,
              abv: ingredient.abv,
              isBaseSpirit: ingredient.isBaseSpirit
            }))
          };
      const shareUrl = buildShareUrl(state, window.location.origin);

      if (!shareUrl.ok) {
        if (shareUrl.reason === 'url_too_long') {
          await this.copyRecipe();
          this.showToast('Share link was too long, so the recipe was copied instead.', 'success');
          track('share_failed_too_large', { mode: state.mode });
        } else {
          this.showToast('Add a complete recipe before sharing.', 'error');
        }
        return;
      }

      const url = shareUrl.url.toString();
      const title = state.mode === 'preset'
        ? `${this.getRecipeName(state.recipe)} Freezer Batch`
        : 'My Freezer Batch Recipe';
      const text = 'Batch responsibly and keep frozen cocktails clearly labeled.';

      // A preset share targets the recipe's canonical page; a custom share
      // targets the homepage calculator.
      const shareTarget = state.mode === 'preset' ? 'canonical-recipe' : 'homepage-custom';

      if (navigator.share) {
        try {
          await navigator.share({
            title,
            text,
            url
          });
          track('share_created', { mode: state.mode, method: 'webshare', target: shareTarget });
        } catch {
          this.copyToClipboard(url);
          track('share_created', { mode: state.mode, method: 'clipboard', target: shareTarget });
        }
      } else {
        this.copyToClipboard(url);
        track('share_created', { mode: state.mode, method: 'clipboard', target: shareTarget });
      }
    }

    private copyToClipboard(text: string) {
      navigator.clipboard.writeText(text).then(() => {
        this.showToast('Recipe link copied to clipboard!', 'success');
      }).catch(() => {
        prompt('Copy this link to share your recipe:', text);
      });
    }

    private showToast(message: string, type: 'success' | 'error' = 'success') {
      document.querySelectorAll('.toast').forEach(t => t.remove());

      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;
      document.body.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 3000);
    }

    /**
     * Build a clean plain-text version of the recipe and write it to the
     * clipboard. Replaces the previous email-modal flow — no friction,
     * no signup, instant pastable text.
     */
    private async copyRecipe() {
      const data = this.buildRecipeData();
      const lines: string[] = [];
      lines.push(`${data.name} — Freezer Batch (${data.bottleSize})`);
      lines.push('');
      lines.push(`ABV: ${data.abv}%   Drinks: ${data.servings}`);
      lines.push('');
      lines.push(`Pour off: ${data.pourOff}`);
      data.ingredients.forEach(i => lines.push(`Add ${i.amount} ${i.name}`));
      if (data.waterToAdd && parseFloat(data.waterToAdd) > 0) {
        lines.push(`Add ${data.waterToAdd} water`);
      }
      lines.push('');
      lines.push('Cap, shake, freeze 4+ hours.');
      lines.push('');
      lines.push('via freezerbatchcocktails.com');
      const text = lines.join('\n');

      try {
        await navigator.clipboard.writeText(text);
        this.showToast('Recipe copied — paste anywhere', 'success');
      } catch {
        // Older browsers / insecure context: fallback to a prompt
        prompt('Copy this recipe:', text);
      }
    }

    private setupEmailForm(form: HTMLFormElement) {
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        void this.handleEmailSubmit(form);
      });
      form.addEventListener('input', () => this.emailRequestIds.delete(form));
      this.initializeEmailTurnstile(form);
    }

    private async loadTurnstile(): Promise<any> {
      if ((window as any).turnstile) return (window as any).turnstile;
      if ((window as any).__fbcTurnstilePromise) return (window as any).__fbcTurnstilePromise;

      (window as any).__fbcTurnstilePromise = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.defer = true;
        script.onload = () => (window as any).turnstile ? resolve((window as any).turnstile) : reject(new Error('Turnstile did not load'));
        script.onerror = () => reject(new Error('Turnstile failed to load'));
        document.head.appendChild(script);
      });
      return (window as any).__fbcTurnstilePromise;
    }

    private initializeEmailTurnstile(form: HTMLFormElement) {
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const note = form.querySelector<HTMLElement>('.turnstile-note');
      const container = form.querySelector<HTMLElement>('.turnstile-container');
      const siteKey = this.dataset.turnstileSiteKey || '';

      if (!siteKey) {
        if (submitBtn) submitBtn.disabled = true;
        if (note) note.textContent = 'Email delivery is unavailable in local development because verification is not configured.';
        return;
      }
      if (!container || !submitBtn) return;

      submitBtn.disabled = true;
      if (note) note.textContent = 'Complete the verification challenge to send your recipe.';
      void this.loadTurnstile()
        .then((turnstile) => {
          const widgetId = turnstile.render(container, {
            sitekey: siteKey,
            callback: (token: string) => {
              form.dataset.turnstileToken = token;
              submitBtn.disabled = false;
              if (note) note.textContent = '';
            },
            'expired-callback': () => this.clearEmailTurnstileToken(form),
            'error-callback': () => this.clearEmailTurnstileToken(form),
          });
          this.emailTurnstileWidgets.set(form, widgetId);
        })
        .catch(() => {
          if (note) note.textContent = 'Verification could not load. Please refresh and try again.';
        });
    }

    private setEmailTurnstilePending(form: HTMLFormElement, noteText = '') {
      delete form.dataset.turnstileToken;
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const note = form.querySelector<HTMLElement>('.turnstile-note');
      if (submitBtn) submitBtn.disabled = true;
      if (note) note.textContent = noteText;
    }

    private clearEmailTurnstileToken(form: HTMLFormElement) {
      this.setEmailTurnstilePending(form, 'Please retry the verification challenge.');
    }

    private resetEmailTurnstile(form: HTMLFormElement) {
      this.setEmailTurnstilePending(form);
      const widgetId = this.emailTurnstileWidgets.get(form);
      if (widgetId !== undefined && (window as any).turnstile) {
        (window as any).turnstile.reset(widgetId);
      }
    }

    private recipeEmailPayload() {
      const display = this.buildRecipeData();
      if (this.mode === 'preset' && this.currentPresetId) {
        return { mode: 'preset' as const, slug: this.currentPresetId, bottleMl: this.bottleSizeMl, unit: this.unit, display };
      }
      return {
        mode: 'custom' as const,
        bottleMl: this.bottleSizeMl,
        unit: this.unit,
        dilutionPercent: this.dilutionPercent,
        ingredients: this.getRecipeIngredients().map(({ name, amount, abv, isBaseSpirit }) => ({ name, amount, abv, isBaseSpirit })),
        display,
      };
    }

    private emailErrorMessage(code: string | undefined): string {
      switch (code) {
        case 'invalid_request': return 'Please check the form and try again.';
        case 'verification_failed': return 'Please retry the challenge.';
        case 'rate_limited': return 'Please try again in a minute.';
        case 'upstream_unavailable': return "We'll be back shortly.";
        default: return 'Couldn\'t send. Try again or copy the recipe instead.';
      }
    }

    /**
     * Inline email-recipe submission through the same-origin Pages Function.
     * the result inline (no modal). Works for both the static custom-mode
     * form and the dynamically-rendered preset form.
     */
    private async handleEmailSubmit(form: HTMLFormElement) {
      const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
      const subscribeInput = form.querySelector<HTMLInputElement>('input[name="subscribe"]');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const sendIcon = form.querySelector<HTMLElement>('.email-send-icon');
      const spinner = form.querySelector<HTMLElement>('.email-send-spinner');
      const label = form.querySelector<HTMLElement>('.email-send-label');
      const status = form.querySelector<HTMLElement>('.email-status');

      const email = emailInput?.value.trim();
      const turnstileToken = form.dataset.turnstileToken;
      if (!email || !turnstileToken || submitBtn?.disabled) return;
      const requestId = this.emailRequestIds.get(form) || crypto.randomUUID();
      this.emailRequestIds.set(form, requestId);

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      sendIcon?.classList.add('hidden');
      spinner?.classList.remove('hidden');
      if (label) label.textContent = 'Sending…';
      if (status) {
        status.classList.add('hidden');
        status.textContent = '';
      }

      try {
        const res = await fetch('/api/email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'send_recipe',
            requestId,
            email,
            recipe: this.recipeEmailPayload(),
            marketingConsent: !!subscribeInput?.checked,
            ...(subscribeInput?.checked ? { consentVersion: '2026-07-23' } : {}),
            page: window.location.pathname,
            turnstileToken,
            website: form.querySelector<HTMLInputElement>('input[name="website"]')?.value || '',
          }),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          const code = typeof body.code === 'string' ? body.code : undefined;
          if ([403, 429, 502].includes(res.status)) this.resetEmailTurnstile(form);
          if (res.status === 400) this.emailRequestIds.delete(form);
          throw new Error(code || 'email_request_failed');
        }

        // Analytics: consent flag and mode only — never the address.
        if (res.status === 202) {
          track('email_recipe_sent', { consent: !!subscribeInput?.checked, mode: this.mode });
        }

        // Success — collapse the form to a clean confirmation line
        if (status) {
          status.textContent = `✓ Sent to ${email} — check your inbox.`;
          status.className = 'email-status mt-2 text-xs text-success font-medium';
          status.focus();
        }
        if (emailInput) emailInput.value = '';
        if (subscribeInput) subscribeInput.checked = false;
        this.emailRequestIds.delete(form);
        this.resetEmailTurnstile(form);
      } catch (err) {
        if (err instanceof TypeError) this.resetEmailTurnstile(form);
        if (status) {
          status.textContent = this.emailErrorMessage(err instanceof Error ? err.message : undefined);
          status.className = 'email-status mt-2 text-xs text-danger';
          status.focus();
        }
      } finally {
        if (submitBtn) submitBtn.disabled = !form.dataset.turnstileToken;
        sendIcon?.classList.remove('hidden');
        spinner?.classList.add('hidden');
        if (label) label.textContent = 'Email me this';
      }
    }

    private buildRecipeData() {
      const abvEl = this.querySelector('#final-abv');
      const pourOffEl = this.querySelector('#pour-off');
      const waterEl = this.querySelector('#water-add');
      const servingsEl = this.querySelector('#servings');

      // Get ingredients from the output panel
      const ingredientItems = this.querySelectorAll('#ingredients-output > div');
      const ingredients: Array<{ name: string; amount: string }> = [];
      ingredientItems.forEach(item => {
        const name = item.querySelector('.text-gray-600')?.textContent?.trim() || '';
        const amount = item.querySelector('.font-mono')?.textContent?.trim() || '';
        if (name && amount) {
          ingredients.push({ name, amount });
        }
      });

      return {
        name: this.currentPresetId ? this.getRecipeName(this.currentPresetId) : 'Custom Recipe',
        presetId: this.currentPresetId,
        bottleSize: `${this.bottleSizeMl}ml`,
        unit: this.unit,
        abv: abvEl?.textContent || '0',
        servings: servingsEl?.textContent || '0',
        pourOff: pourOffEl?.textContent || '0',
        waterToAdd: waterEl?.textContent || '0',
        ingredients,
        dilution: `${this.dilutionPercent}%`
      };
    }
  }

  customElements.define('batch-calculator', BatchCalculator);
</script>
